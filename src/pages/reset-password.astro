---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Reset Password | The Family Bank">
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-5 py-10" data-base-url={import.meta.env.BASE_URL} id="password-reset-page">
    <section class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200 sm:p-8">
      <div class="text-center">
        <div class="text-5xl" aria-hidden="true">🔑</div>
        <p class="mt-5 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">Parent account</p>
        <h1 class="mt-1 text-3xl font-black">Choose a new password</h1>
        <p class="mt-2 text-sm leading-6 text-slate-500">Use at least 8 characters that you can remember.</p>
      </div>

      <p id="password-reset-loading" class="mt-6 text-center text-sm font-bold text-slate-500">Checking your reset link…</p>

      <form id="password-reset-form" class="mt-6 hidden grid gap-4">
        <label class="text-sm font-bold text-slate-700">New password<input name="password" type="password" minlength="8" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" /></label>
        <label class="text-sm font-bold text-slate-700">Confirm password<input name="confirmation" type="password" minlength="8" autocomplete="new-password" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-100" /></label>
        <p id="password-reset-error" class="hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700" role="alert"></p>
        <button type="submit" class="rounded-xl bg-blue-600 px-5 py-3 font-bold text-white hover:bg-blue-700 disabled:cursor-wait disabled:opacity-60">Save New Password</button>
      </form>

      <div id="password-reset-success" class="mt-6 hidden rounded-2xl bg-emerald-50 p-5 text-center text-emerald-800">
        <p class="font-black">Password updated!</p>
        <a href={import.meta.env.BASE_URL} class="mt-3 inline-block font-bold text-emerald-700 underline">Return to The Family Bank</a>
      </div>
    </section>
  </main>

  <script>
    import { updateParentPassword } from "../lib/auth";
    import { clearProfileUnlocks } from "../lib/profileLock";
    import { getSupabaseClient } from "../lib/supabase";

    const form = document.querySelector<HTMLFormElement>("#password-reset-form");
    const loading = document.querySelector<HTMLElement>("#password-reset-loading");
    const error = document.querySelector<HTMLElement>("#password-reset-error");
    const success = document.querySelector<HTMLElement>("#password-reset-success");
    const client = getSupabaseClient();

    function showError(message: string): void {
      if (loading) {
        loading.textContent = message;
        loading.classList.add("text-red-700");
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!client || !form || !form.reportValidity()) return;

      const data = new FormData(form);
      const password = String(data.get("password") ?? "");
      const confirmation = String(data.get("confirmation") ?? "");

      if (password !== confirmation) {
        if (error) {
          error.textContent = "The passwords do not match.";
          error.classList.remove("hidden");
        }
        return;
      }

      error?.classList.add("hidden");
      form.querySelector<HTMLButtonElement>("button")!.disabled = true;

      try {
        await updateParentPassword(client, password);
        clearProfileUnlocks();
        form.classList.add("hidden");
        success?.classList.remove("hidden");
      } catch (caught) {
        if (error) {
          error.textContent = caught instanceof Error ? caught.message : "Unable to update the password.";
          error.classList.remove("hidden");
        }
      } finally {
        form.querySelector<HTMLButtonElement>("button")!.disabled = false;
      }
    });

    async function initialize(): Promise<void> {
      if (!client) {
        showError("Password recovery is unavailable on this build.");
        return;
      }

      const { data, error: sessionError } = await client.auth.getSession();
      if (sessionError || !data.session) {
        showError("This password reset link is invalid or has expired. Request a new one from the Parent Dashboard.");
        return;
      }

      loading?.classList.add("hidden");
      form?.classList.remove("hidden");
    }

    void initialize();
  </script>
</Layout>
