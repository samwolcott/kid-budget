    function renderGoals(kid: Kid): string {
      if (kid.goals.length === 0) {
        return `
          <div class="rounded-3xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-emerald-50 text-3xl" aria-hidden="true">🎯</div>
            <h3 class="mt-4 text-lg font-black">Pick something worth saving for</h3>
            <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
              Your first goal can be anything you are excited to work toward.
            </p>
            <button type="button" data-new-goal class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-600 px-5 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">
              Create my first goal
            </button>
          </div>
        `;
      }

      return kid.goals
        .map((goal) => {
          const percent = Math.min(
            100,
            Math.max(
              0,
              goal.target > 0
                ? (goal.saved / goal.target) * 100
                : 0,
            ),
          );

          const remaining = Math.max(
            0,
            goal.target - goal.saved,
          );

          return `
            <article class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200/80 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-emerald-50 text-2xl" aria-hidden="true">
                    ${escapeHtml(goal.emoji)}
                  </div>

                  <div class="min-w-0">
                    <h3 class="truncate text-lg font-black text-slate-950">
                      ${escapeHtml(goal.name)}
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                      <strong class="font-bold text-slate-700">
                        ${money.format(goal.saved)}
                      </strong>
                      of ${money.format(goal.target)}
                    </p>
                  </div>
                </div>

                <span class="shrink-0 rounded-full bg-emerald-50 px-3 py-1 text-sm font-extrabold text-emerald-700">
                  ${Math.round(percent)}%
                </span>
              </div>

              <div class="mt-5 h-3 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="${escapeHtml(goal.name)} savings progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(percent)}">
                <div class="h-full rounded-full bg-emerald-500 transition-all duration-500" style="width: ${percent}%"></div>
              </div>

              <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm text-slate-500">
                  ${remaining === 0 ? "Goal complete! 🎉" : `${money.format(remaining)} left to go`}
                </p>

                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    data-edit-goal-id="${goal.id}"
                    class="inline-flex min-h-10 items-center justify-center rounded-xl bg-blue-50 px-3 text-sm font-bold text-blue-700 transition hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    Edit
                  </button>

                  ${goal.saved > 0 ? `
                    <button
                      type="button"
                      data-remove-goal-id="${goal.id}"
                      class="inline-flex min-h-10 items-center justify-center rounded-xl bg-violet-50 px-3 text-sm font-bold text-violet-700 transition hover:bg-violet-100 focus:outline-none focus:ring-2 focus:ring-violet-500"
                    >
                      Remove money
                    </button>
                  ` : ""}

                  ${remaining === 0 ? `
                    <button
                      type="button"
                      data-complete-goal-id="${goal.id}"
                      class="inline-flex min-h-10 items-center justify-center rounded-xl bg-emerald-600 px-4 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    >
                      Complete purchase
                    </button>
                  ` : `
                    <button
                      type="button"
                      data-goal-id="${goal.id}"
                      class="inline-flex min-h-10 items-center justify-center rounded-xl bg-emerald-600 px-4 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    >
                      Add money
                    </button>
                  `}

                  <button
                    type="button"
