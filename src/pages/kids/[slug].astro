---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/kid/Header.astro";
import BalanceCard from "../../components/kid/BalanceCard.astro";
import BucketGrid from "../../components/kid/BucketGrid.astro";
import GoalList from "../../components/kid/GoalList.astro";
import QuickActions from "../../components/kid/QuickActions.astro";
import RecentActivity from "../../components/kid/RecentActivity.astro";

import { kids as demoKids } from "../../data/demo";
import { getKid, getKids } from "../../lib/api";
import { totalBalance } from "../../lib/money";

export async function getStaticPaths() {
  const kids = await getKids();

  return kids.map((kid) => ({
    params: {
      slug: kid.slug,
    },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const kid = await getKid(slug);

if (!kid) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const total = totalBalance(kid.buckets);

const allocatedSavings = kid.goals.reduce(
  (sum, goal) => sum + goal.saved,
  0,
);

const unallocatedSavings = Math.max(
  0,
  kid.buckets.saving - allocatedSavings,
);

const demoJson = JSON.stringify(demoKids);
---

<Layout
  title={`${kid.name} | The Family Bank`}
  description={`${kid.name}'s spending, saving, and giving dashboard.`}
>
  <main
    id="kid-dashboard"
    class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-10"
    data-kid-slug={kid.slug}
    data-base-url={import.meta.env.BASE_URL}
  >
    <Header
      name={kid.name}
      emoji={kid.emoji}
    />

    <BalanceCard
      total={total}
      unallocatedSavings={unallocatedSavings}
    />

    <BucketGrid buckets={kid.buckets} />

    <GoalList goals={kid.goals} />

    <QuickActions />

    <RecentActivity transactions={kid.transactions} />

    <footer class="mt-12 pb-4 text-center text-sm text-slate-400">
      The Family Bank · Spend, save, and give wisely.
    </footer>
  </main>

  <dialog
    id="purchase-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="purchase-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
            Record a purchase
          </p>

          <h2 class="mt-1 text-2xl font-black">
            What did you buy?
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Your parent will approve it before any money leaves your account.
          </p>
        </div>

        <button
          id="close-purchase-dialog"
          type="button"
          class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200"
          aria-label="Close"
        >
          ×
        </button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        What was it?
        <input
          id="purchase-description"
          name="description"
          type="text"
          maxlength="80"
          required
          placeholder="Ice cream"
          class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100"
        />
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        How much did it cost?
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-100">
          <span class="font-bold text-slate-400">$</span>
          <input
            id="purchase-amount"
            name="amount"
            type="number"
            min="0.01"
            step="0.01"
            inputmode="decimal"
            required
            placeholder="4.50"
            class="min-w-0 w-full bg-transparent px-2 py-3 outline-none"
          />
        </span>
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Which bucket should pay for it?
        <select
          id="purchase-bucket"
          name="bucket"
          class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100"
        >
          <option value="spending">🛒 Spending</option>
          <option value="saving">🎯 Saving</option>
          <option value="giving">❤️ Giving</option>
        </select>
      </label>

      <p
        id="purchase-balance-help"
        class="mt-3 text-sm text-slate-500"
      ></p>

      <p
        id="purchase-error"
        class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"
      ></p>

      <button
        type="submit"
        class="mt-6 w-full rounded-xl bg-blue-600 px-5 py-3 font-bold text-white transition hover:bg-blue-700"
      >
        Send for Parent Approval
      </button>
    </form>
  </dialog>

  <dialog
    id="move-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="move-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-violet-600">
            Move money
          </p>
          <h2 class="mt-1 text-2xl font-black">Choose your buckets</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Move money without changing your total balance.
          </p>
        </div>
        <button id="close-move-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <div class="mt-6 grid grid-cols-[1fr_auto_1fr] items-end gap-3">
        <label class="text-sm font-bold text-slate-700">
          From
          <select id="move-from" name="from" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-3 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100">
            <option value="spending">🛒 Spending</option>
            <option value="saving">🎯 Saving</option>
            <option value="giving">❤️ Giving</option>
          </select>
        </label>
        <span class="pb-3 text-xl text-slate-400" aria-hidden="true">→</span>
        <label class="text-sm font-bold text-slate-700">
          To
          <select id="move-to" name="to" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-3 py-3 outline-none transition focus:border-violet-400 focus:ring-2 focus:ring-violet-100">
            <option value="saving">🎯 Saving</option>
            <option value="giving">❤️ Giving</option>
            <option value="spending">🛒 Spending</option>
          </select>
        </label>
      </div>

      <p id="move-balance-help" class="mt-3 text-sm text-slate-500"></p>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Amount to move
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-violet-400 focus-within:ring-2 focus-within:ring-violet-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="5.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <p id="move-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-violet-600 px-5 py-3 font-bold text-white transition hover:bg-violet-700">Move Money</button>
    </form>
  </dialog>

  <dialog
    id="new-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="new-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
            New savings goal
          </p>
          <h2 class="mt-1 text-2xl font-black">What are you saving for?</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Pick something exciting and set the amount you need.
          </p>
        </div>
        <button id="close-new-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <fieldset class="mt-6">
        <legend class="text-sm font-bold text-slate-700">
          Choose an icon
        </legend>

        <div class="mt-3 flex items-center gap-4 rounded-2xl bg-emerald-50 p-4 ring-1 ring-emerald-100">
          <div
            id="selected-goal-emoji"
            class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white text-4xl shadow-sm ring-2 ring-emerald-500"
            aria-hidden="true"
          >
            🎯
          </div>

          <div>
            <strong class="block text-slate-900">Selected icon</strong>
            <span class="mt-1 block text-sm text-slate-500">
              Tap any emoji below to change it.
            </span>
          </div>
        </div>

        <input
          id="goal-emoji-input"
          name="emoji"
          type="hidden"
          value="🎯"
        />

        <div
          id="goal-emoji-picker"
          class="mt-4 grid grid-cols-6 gap-2 sm:grid-cols-8"
          aria-label="Choose a goal icon"
        ></div>
      </fieldset>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Goal name
        <input name="name" type="text" maxlength="80" required placeholder="Nintendo Switch Game" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" />
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Target price
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="target" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="60.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <p id="new-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700">Create Goal</button>
    </form>
  </dialog>

  <dialog
    id="edit-goal-dialog"
    class="fixed inset-0 m-auto max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-md overflow-y-auto rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="edit-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
            Edit savings goal
          </p>
          <h2 class="mt-1 text-2xl font-black">Update your goal</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Change the icon, name, or target. Money already saved stays in the goal.
          </p>
        </div>
        <button id="close-edit-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <fieldset class="mt-6">
        <legend class="text-sm font-bold text-slate-700">Choose an icon</legend>

        <div class="mt-3 flex items-center gap-4 rounded-2xl bg-blue-50 p-4 ring-1 ring-blue-100">
          <div
            id="selected-edit-goal-emoji"
            class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white text-4xl shadow-sm ring-2 ring-blue-500"
            aria-hidden="true"
          >
            🎯
          </div>
          <div>
            <strong class="block text-slate-900">Selected icon</strong>
            <span class="mt-1 block text-sm text-slate-500">Tap an emoji below to change it.</span>
          </div>
        </div>

        <input id="edit-goal-emoji-input" name="emoji" type="hidden" value="🎯" />
        <div id="edit-goal-emoji-picker" class="mt-4 grid grid-cols-6 gap-2 sm:grid-cols-8" aria-label="Choose a goal icon"></div>
      </fieldset>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Goal name
        <input id="edit-goal-name" name="name" type="text" maxlength="80" required class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100" />
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Target price
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-100">
          <span class="font-bold text-slate-400">$</span>
          <input id="edit-goal-target" name="target" type="number" min="0.01" step="0.01" inputmode="decimal" required class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <input id="edit-goal-id" name="goalId" type="hidden" />
      <p id="edit-goal-saved-help" class="mt-3 text-sm text-slate-500"></p>
      <p id="edit-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button id="save-edit-goal" type="submit" class="mt-6 w-full rounded-xl bg-blue-600 px-5 py-3 font-bold text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500">Save Changes</button>
    </form>
  </dialog>

  <dialog
    id="allocate-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="allocate-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">Allocate savings</p>
          <h2 id="allocate-goal-title" class="mt-1 text-2xl font-black">Add money to goal</h2>
          <p id="allocate-goal-help" class="mt-2 text-sm leading-6 text-slate-500"></p>
        </div>
        <button id="close-allocate-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        Amount to add
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="5.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <input id="allocate-goal-id" name="goalId" type="hidden" />
      <p id="allocate-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700">Add to Goal</button>
    </form>
  </dialog>

  <dialog
    id="remove-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="remove-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-violet-600">Remove allocation</p>
          <h2 id="remove-goal-title" class="mt-1 text-2xl font-black">Move money out of goal</h2>
          <p id="remove-goal-help" class="mt-2 text-sm leading-6 text-slate-500"></p>
        </div>
        <button id="close-remove-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        Amount to remove
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-violet-400 focus-within:ring-2 focus-within:ring-violet-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="5.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <input id="remove-goal-id" name="goalId" type="hidden" />
      <p id="remove-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-violet-600 px-5 py-3 font-bold text-white transition hover:bg-violet-700">Return to Available Saving</button>
    </form>
  </dialog>

  <dialog
    id="delete-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-red-600">Delete goal</p>
          <h2 id="delete-goal-title" class="mt-1 text-2xl font-black">Delete this goal?</h2>
          <p id="delete-goal-help" class="mt-2 text-sm leading-6 text-slate-500"></p>
        </div>
        <button id="close-delete-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <div class="mt-6 flex gap-3">
        <button id="cancel-delete-goal" type="button" class="flex-1 rounded-xl bg-slate-100 px-5 py-3 font-bold text-slate-700 transition hover:bg-slate-200">Cancel</button>
        <button id="confirm-delete-goal" type="button" class="flex-1 rounded-xl bg-red-600 px-5 py-3 font-bold text-white transition hover:bg-red-700">Delete Goal</button>
      </div>
    </div>
  </dialog>

  <dialog
    id="complete-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <div class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">Goal complete</p>
          <h2 id="complete-goal-title" class="mt-1 text-2xl font-black">Did you buy it?</h2>
          <p id="complete-goal-help" class="mt-2 text-sm leading-6 text-slate-500"></p>
        </div>
        <button id="close-complete-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <div class="mt-5 rounded-2xl bg-emerald-50 p-4 text-sm leading-6 text-emerald-800">
        This will deduct the purchase from Saving, remove the goal, and add it to Recent Activity.
      </div>

      <div class="mt-6 flex gap-3">
        <button id="cancel-complete-goal" type="button" class="flex-1 rounded-xl bg-slate-100 px-5 py-3 font-bold text-slate-700 transition hover:bg-slate-200">Cancel</button>
        <button id="confirm-complete-goal" type="button" class="flex-1 rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700">Complete Purchase</button>
      </div>
    </div>
  </dialog>

  <dialog
    id="history-dialog"
    class="fixed inset-0 m-auto max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded-3xl bg-slate-100 p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <div class="p-5 sm:p-7">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
            Account history
          </p>
          <h2 class="mt-1 text-3xl font-black">All activity</h2>
          <p id="history-count" class="mt-2 text-sm text-slate-500"></p>
        </div>
        <button id="close-history-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white text-xl text-slate-600 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50" aria-label="Close">×</button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        Show activity from
        <select id="history-filter" class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100">
          <option value="all">All buckets</option>
          <option value="spending">🛒 Spending</option>
          <option value="saving">🎯 Saving</option>
          <option value="giving">❤️ Giving</option>
        </select>
      </label>

      <div id="history-list" class="mt-5 divide-y divide-slate-100 overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200/80"></div>
    </div>
  </dialog>

  <div
    id="confetti"
    class="pointer-events-none fixed inset-0 z-[60] overflow-hidden"
    aria-hidden="true"
  ></div>

  <div
    id="prototype-toast"
    class="pointer-events-none fixed bottom-5 left-1/2 z-50 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 translate-y-5 rounded-2xl bg-slate-950 px-5 py-4 text-center text-sm font-bold text-white opacity-0 shadow-2xl transition-all duration-200"
    role="status"
    aria-live="polite"
  ></div>

  <script
    type="application/json"
    id="demo-kids"
    set:html={demoJson}
  ></script>

  <script>
    import type {
      BucketType,
      FamilyBankState,
      Kid,
      Transaction,
    } from "../../types";

    import {
      allocateToGoal,
      completeGoalPurchase,
      createGoal,
      createPurchaseRequest,
      deleteGoal,
      editGoal,
