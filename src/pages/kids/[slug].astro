    let currentKid: Kid | null = null;
    let currentState: FamilyBankState | null = null;

    function updatePurchaseBalanceHelp(): void {
      if (
        !currentKid ||
        !(purchaseBucket instanceof HTMLSelectElement) ||
        !(purchaseBalanceHelp instanceof HTMLElement)
      ) {
        return;
      }

      const bucket = purchaseBucket.value as BucketType;
      const meta = bucketMeta[bucket];

      purchaseBalanceHelp.textContent =
        `${meta.icon} ${meta.label} balance: ${money.format(currentKid.buckets[bucket])}`;
    }

    function openPurchaseDialog(): void {
      if (!(purchaseDialog instanceof HTMLDialogElement)) {
        return;
      }

      if (purchaseError instanceof HTMLElement) {
        purchaseError.classList.add("hidden");
        purchaseError.textContent = "";
      }

      updatePurchaseBalanceHelp();
      purchaseDialog.showModal();

      window.setTimeout(() => {
        document
          .querySelector<HTMLInputElement>(
            "#purchase-description",
          )
          ?.focus();
      }, 0);
    }

    function availableBucketBalance(bucket: BucketType): number {
      if (!currentKid) return 0;
      if (bucket !== "saving") return currentKid.buckets[bucket];

      const allocated = currentKid.goals.reduce(
        (sum, goal) => sum + goal.saved,
        0,
      );

      return Math.max(0, currentKid.buckets.saving - allocated);
    }

    function updateMoveBalanceHelp(): void {
      if (
        !currentKid ||
        !(moveFrom instanceof HTMLSelectElement) ||
        !(moveTo instanceof HTMLSelectElement) ||
        !(moveBalanceHelp instanceof HTMLElement)
      ) return;

      const from = moveFrom.value as BucketType;
      const matchingOption = moveTo.querySelector<HTMLOptionElement>(
        `option[value="${from}"]`,
      );

      moveTo.querySelectorAll("option").forEach((option) => {
        option.disabled = false;
      });

      if (matchingOption) matchingOption.disabled = true;

      if (moveTo.value === from) {
        const nextDestination = Array.from(moveTo.options).find(
          (option) => !option.disabled,
        );
        if (nextDestination) moveTo.value = nextDestination.value;
      }

      const meta = bucketMeta[from];
      const qualifier = from === "saving" ? "Available Saving" : meta.label;
      moveBalanceHelp.textContent =
        `${meta.icon} ${qualifier}: ${money.format(availableBucketBalance(from))}`;
    }

    function openMoveDialog(): void {
      if (!(moveDialog instanceof HTMLDialogElement)) return;
      if (moveForm instanceof HTMLFormElement) moveForm.reset();
      if (moveError instanceof HTMLElement) {
        moveError.classList.add("hidden");
        moveError.textContent = "";
      }
      updateMoveBalanceHelp();
      moveDialog.showModal();
    }

    function openNewGoalDialog(): void {
      if (!(newGoalDialog instanceof HTMLDialogElement)) return;
      if (newGoalError instanceof HTMLElement) {
        newGoalError.classList.add("hidden");
        newGoalError.textContent = "";
      }
      if (newGoalForm instanceof HTMLFormElement) newGoalForm.reset();
      setSelectedGoalEmoji("🎯");
      newGoalDialog.showModal();
      window.setTimeout(() => newGoalForm?.querySelector<HTMLInputElement>('[name="name"]')?.focus(), 0);
    }

    function openEditGoalDialog(goalId: string): void {
      if (!currentKid || !(editGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      if (editGoalId instanceof HTMLInputElement) editGoalId.value = goal.id;
      if (editGoalName instanceof HTMLInputElement) editGoalName.value = goal.name;
      if (editGoalTarget instanceof HTMLInputElement) {
        editGoalTarget.value = goal.target.toFixed(2);
        editGoalTarget.min = Math.max(0.01, goal.saved).toFixed(2);
      }
      if (editGoalSavedHelp instanceof HTMLElement) {
        editGoalSavedHelp.textContent = goal.saved > 0
          ? `${money.format(goal.saved)} is already saved, so the target cannot be lower than that.`
          : "No money is allocated yet, so you can choose any target above $0.";
      }
      if (editGoalError instanceof HTMLElement) {
        editGoalError.classList.add("hidden");
        editGoalError.textContent = "";
      }

      setSelectedEditGoalEmoji(goal.emoji);
      updateEditGoalButton();
      editGoalDialog.showModal();
      window.setTimeout(() => editGoalName instanceof HTMLInputElement && editGoalName.focus(), 0);
    }

    function openAllocateGoalDialog(goalId: string): void {
      if (!currentKid || !(allocateGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      const allocated = currentKid.goals.reduce((sum, item) => sum + item.saved, 0);
      const available = Math.max(0, currentKid.buckets.saving - allocated);
      const remaining = Math.max(0, goal.target - goal.saved);

      if (allocateGoalTitle instanceof HTMLElement) {
        allocateGoalTitle.textContent = `Add to ${goal.name}`;
      }
      if (allocateGoalHelp instanceof HTMLElement) {
        allocateGoalHelp.textContent = `${money.format(available)} is available to allocate. This goal needs ${money.format(remaining)} more.`;
      }
      if (allocateGoalId instanceof HTMLInputElement) allocateGoalId.value = goal.id;
      if (allocateGoalError instanceof HTMLElement) {
        allocateGoalError.classList.add("hidden");
        allocateGoalError.textContent = "";
      }
      if (allocateGoalForm instanceof HTMLFormElement) {
        const amount = allocateGoalForm.querySelector<HTMLInputElement>('[name="amount"]');
        if (amount) amount.value = "";
      }
      allocateGoalDialog.showModal();
      window.setTimeout(() => allocateGoalForm?.querySelector<HTMLInputElement>('[name="amount"]')?.focus(), 0);
    }

    function openRemoveGoalDialog(goalId: string): void {
      if (!currentKid || !(removeGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      selectedGoalId = goal.id;
      if (removeGoalTitle instanceof HTMLElement) removeGoalTitle.textContent = `Remove money from ${goal.name}`;
      if (removeGoalHelp instanceof HTMLElement) removeGoalHelp.textContent = `${money.format(goal.saved)} is currently allocated. Removed money becomes available for another goal.`;
      if (removeGoalId instanceof HTMLInputElement) removeGoalId.value = goal.id;
      if (removeGoalError instanceof HTMLElement) {
        removeGoalError.classList.add("hidden");
        removeGoalError.textContent = "";
      }
      if (removeGoalForm instanceof HTMLFormElement) {
        const amount = removeGoalForm.querySelector<HTMLInputElement>('[name="amount"]');
        if (amount) {
          amount.value = "";
          amount.max = String(goal.saved);
        }
      }
      removeGoalDialog.showModal();
      window.setTimeout(() => removeGoalForm?.querySelector<HTMLInputElement>('[name="amount"]')?.focus(), 0);
    }

    function openDeleteGoalDialog(goalId: string): void {
      if (!currentKid || !(deleteGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      selectedGoalId = goal.id;
      if (deleteGoalTitle instanceof HTMLElement) deleteGoalTitle.textContent = `Delete ${goal.name}?`;
      if (deleteGoalHelp instanceof HTMLElement) {
        deleteGoalHelp.textContent = goal.saved > 0
          ? `${money.format(goal.saved)} will return to Available Saving. Your total Saving balance will not change.`
          : "This goal has no money allocated to it.";
      }
      deleteGoalDialog.showModal();
    }

    function openCompleteGoalDialog(goalId: string): void {
      if (!currentKid || !(completeGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      selectedGoalId = goal.id;
      if (completeGoalTitle instanceof HTMLElement) completeGoalTitle.textContent = `Buy ${goal.name}?`;
      if (completeGoalHelp instanceof HTMLElement) completeGoalHelp.textContent = `${money.format(goal.target)} will be deducted from Saving.`;
      completeGoalDialog.showModal();
    }

    function renderFullHistory(): void {
      if (
        !currentKid ||
        !(historyFilter instanceof HTMLSelectElement) ||
        !(historyCount instanceof HTMLElement) ||
        !(historyList instanceof HTMLElement)
      ) return;

      const filter = historyFilter.value;
      const transactions = filter === "all"
        ? currentKid.transactions
        : currentKid.transactions.filter(
            (transaction) => transaction.bucket === filter,
          );
      const label = transactions.length === 1 ? "transaction" : "transactions";

      historyCount.textContent = `${transactions.length} ${label}`;
      historyList.innerHTML = renderActivity(
        transactions,
        "There is no activity in this bucket yet.",
      );
    }

    function openHistoryDialog(): void {
      if (!(historyDialog instanceof HTMLDialogElement)) return;
      if (historyFilter instanceof HTMLSelectElement) historyFilter.value = "all";
      renderFullHistory();
      historyDialog.showModal();
    }

    function attachActionListeners(): void {
      document
        .querySelector<HTMLElement>(
          '[data-action="purchase"]',
        )
        ?.addEventListener(
          "click",
          openPurchaseDialog,
        );

      document
        .querySelector<HTMLElement>(
          '[data-action="move"]',
        )
        ?.addEventListener("click", openMoveDialog);

      document
        .querySelectorAll<HTMLElement>("[data-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.goalId;
            if (goalId) openAllocateGoalDialog(goalId);
          });
        });

      document
        .querySelectorAll<HTMLElement>("[data-edit-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.editGoalId;
            if (goalId) openEditGoalDialog(goalId);
          });
        });

      document
        .querySelectorAll<HTMLElement>("[data-remove-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.removeGoalId;
            if (goalId) openRemoveGoalDialog(goalId);
          });
        });

      document
        .querySelectorAll<HTMLElement>("[data-delete-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.deleteGoalId;
            if (goalId) openDeleteGoalDialog(goalId);
          });
        });

      document
        .querySelectorAll<HTMLElement>("[data-complete-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.completeGoalId;
            if (goalId) openCompleteGoalDialog(goalId);
          });
        });

      document
        .querySelectorAll<HTMLElement>("[data-new-goal]")
        .forEach((button) => {
          button.addEventListener("click", openNewGoalDialog);
        });

      document
        .querySelector<HTMLElement>("[data-view-history]")
        ?.addEventListener("click", openHistoryDialog);
    }

    closeHistoryDialog?.addEventListener("click", () => {
      if (historyDialog instanceof HTMLDialogElement) historyDialog.close();
    });

    historyDialog?.addEventListener("click", (event) => {
      if (
        historyDialog instanceof HTMLDialogElement &&
        event.target === historyDialog
      ) {
        historyDialog.close();
      }
    });

    historyFilter?.addEventListener("change", renderFullHistory);

    closePurchaseDialog?.addEventListener(
      "click",
      () => {
        if (purchaseDialog instanceof HTMLDialogElement) {
          purchaseDialog.close();
        }
      },
    );

    purchaseDialog?.addEventListener(
      "click",
      (event) => {
        if (
          purchaseDialog instanceof HTMLDialogElement &&
          event.target === purchaseDialog
        ) {
          purchaseDialog.close();
        }
      },
    );

    purchaseBucket?.addEventListener(
      "change",
      updatePurchaseBalanceHelp,
    );

    closeMoveDialog?.addEventListener("click", () => {
      if (moveDialog instanceof HTMLDialogElement) moveDialog.close();
    });

    moveDialog?.addEventListener("click", (event) => {
      if (moveDialog instanceof HTMLDialogElement && event.target === moveDialog) {
        moveDialog.close();
      }
    });

    moveFrom?.addEventListener("change", updateMoveBalanceHelp);

    moveForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(moveForm instanceof HTMLFormElement) || !currentState || !currentKid) return;

      const data = new FormData(moveForm);

      try {
        moveMoney(
          currentState,
          currentKid.slug,
          data.get("from") as BucketType,
          data.get("to") as BucketType,
          Number(data.get("amount")),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        moveDialog instanceof HTMLDialogElement && moveDialog.close();
        showToast("Money moved! ↔️");
      } catch (error) {
        if (moveError instanceof HTMLElement) {
          moveError.textContent = error instanceof Error ? error.message : "Unable to move money.";
          moveError.classList.remove("hidden");
        }
      }
    });

    purchaseForm?.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (
          !(purchaseForm instanceof HTMLFormElement) ||
          !currentState ||
          !currentKid
        ) {
          return;
        }

        const formData = new FormData(purchaseForm);
        const description = String(
          formData.get("description") ?? "",
        );
        const amount = Number(formData.get("amount"));
        const bucket = formData.get("bucket") as BucketType;

        try {
          createPurchaseRequest(
            currentState,
            currentKid.slug,
            description,
            amount,
            bucket,
          );

          saveState(currentState);
          purchaseForm.reset();

          if (purchaseDialog instanceof HTMLDialogElement) {
            purchaseDialog.close();
          }

          showToast(
            "Request sent for parent approval! ⏳",
          );
        } catch (error) {
          if (purchaseError instanceof HTMLElement) {
            purchaseError.textContent =
              error instanceof Error
                ? error.message
                : "Unable to send the purchase request.";
            purchaseError.classList.remove("hidden");
          }
        }
      },
    );

    closeEditGoalDialog?.addEventListener("click", () => {
      if (editGoalDialog instanceof HTMLDialogElement) editGoalDialog.close();
    });

    editGoalDialog?.addEventListener("click", (event) => {
      if (editGoalDialog instanceof HTMLDialogElement && event.target === editGoalDialog) editGoalDialog.close();
    });

    editGoalName?.addEventListener("input", updateEditGoalButton);
    editGoalTarget?.addEventListener("input", updateEditGoalButton);

    editGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(editGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(editGoalForm);

      try {
        editGoal(
          currentState,
          currentKid.slug,
          String(data.get("goalId") ?? ""),
          String(data.get("name") ?? ""),
          Number(data.get("target")),
          String(data.get("emoji") ?? "🎯"),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        editGoalDialog instanceof HTMLDialogElement && editGoalDialog.close();
        showToast("Goal updated! ✏️");
      } catch (error) {
        if (editGoalError instanceof HTMLElement) {
          editGoalError.textContent = error instanceof Error ? error.message : "Unable to update the goal.";
          editGoalError.classList.remove("hidden");
        }
      }
    });

    closeNewGoalDialog?.addEventListener("click", () => {
      if (newGoalDialog instanceof HTMLDialogElement) newGoalDialog.close();
    });

    newGoalDialog?.addEventListener("click", (event) => {
      if (newGoalDialog instanceof HTMLDialogElement && event.target === newGoalDialog) newGoalDialog.close();
    });

    closeAllocateGoalDialog?.addEventListener("click", () => {
      if (allocateGoalDialog instanceof HTMLDialogElement) allocateGoalDialog.close();
    });

    allocateGoalDialog?.addEventListener("click", (event) => {
      if (allocateGoalDialog instanceof HTMLDialogElement && event.target === allocateGoalDialog) allocateGoalDialog.close();
    });

    newGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(newGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(newGoalForm);
      try {
        createGoal(
          currentState,
          currentKid.slug,
          String(data.get("name") ?? ""),
          Number(data.get("target")),
          String(data.get("emoji") ?? "🎯"),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        newGoalDialog instanceof HTMLDialogElement && newGoalDialog.close();
        showToast("New savings goal created! 🎯");
      } catch (error) {
        if (newGoalError instanceof HTMLElement) {
          newGoalError.textContent = error instanceof Error ? error.message : "Unable to create the goal.";
          newGoalError.classList.remove("hidden");
        }
      }
    });

    allocateGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(allocateGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(allocateGoalForm);
      const goalId = String(data.get("goalId") ?? "");
      try {
        allocateToGoal(
          currentState,
          currentKid.slug,
          goalId,
          Number(data.get("amount")),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        const completed = currentKid.goals.some(
          (goal) => goal.id === goalId && goal.saved >= goal.target,
        );
        renderDashboard(currentKid);
        allocateGoalDialog instanceof HTMLDialogElement && allocateGoalDialog.close();
        showToast(completed ? "Goal fully funded! 🎉" : "Savings added to your goal! 🎉");
        if (completed) celebrate();
      } catch (error) {
        if (allocateGoalError instanceof HTMLElement) {
          allocateGoalError.textContent = error instanceof Error ? error.message : "Unable to add money to the goal.";
          allocateGoalError.classList.remove("hidden");
        }
      }
    });

    closeRemoveGoalDialog?.addEventListener("click", () => {
      if (removeGoalDialog instanceof HTMLDialogElement) removeGoalDialog.close();
    });
    removeGoalDialog?.addEventListener("click", (event) => {
      if (removeGoalDialog instanceof HTMLDialogElement && event.target === removeGoalDialog) removeGoalDialog.close();
    });

