---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/kid/Header.astro";
import BalanceCard from "../../components/kid/BalanceCard.astro";
import BucketGrid from "../../components/kid/BucketGrid.astro";
import GoalList from "../../components/kid/GoalList.astro";
import QuickActions from "../../components/kid/QuickActions.astro";
import RecentActivity from "../../components/kid/RecentActivity.astro";

import { kids as demoKids } from "../../data/demo";
import { getKid, getKids } from "../../lib/api";
import { totalBalance } from "../../lib/money";

export async function getStaticPaths() {
  const kids = await getKids();

  return kids.map((kid) => ({
    params: {
      slug: kid.slug,
    },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const kid = await getKid(slug);

if (!kid) {
  return Astro.redirect(import.meta.env.BASE_URL);
}

const total = totalBalance(kid.buckets);

const allocatedSavings = kid.goals.reduce(
  (sum, goal) => sum + goal.saved,
  0,
);

const unallocatedSavings = Math.max(
  0,
  kid.buckets.saving - allocatedSavings,
);

const demoJson = JSON.stringify(demoKids);
---

<Layout
  title={`${kid.name} | The Family Bank`}
  description={`${kid.name}'s spending, saving, and giving dashboard.`}
>
  <main
    id="kid-dashboard"
    class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-10"
    data-kid-slug={kid.slug}
    data-base-url={import.meta.env.BASE_URL}
  >
    <Header
      name={kid.name}
      emoji={kid.emoji}
    />

    <BalanceCard
      total={total}
      unallocatedSavings={unallocatedSavings}
    />

    <BucketGrid buckets={kid.buckets} />

    <GoalList goals={kid.goals} />

    <QuickActions />

    <RecentActivity transactions={kid.transactions} />

    <footer class="mt-12 pb-4 text-center text-sm text-slate-400">
      The Family Bank · Spend, save, and give wisely.
    </footer>
  </main>

  <dialog
    id="purchase-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="purchase-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
            Record a purchase
          </p>

          <h2 class="mt-1 text-2xl font-black">
            What did you buy?
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Your parent will approve it before any money leaves your account.
          </p>
        </div>

        <button
          id="close-purchase-dialog"
          type="button"
          class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200"
          aria-label="Close"
        >
          ×
        </button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        What was it?
        <input
          id="purchase-description"
          name="description"
          type="text"
          maxlength="80"
          required
          placeholder="Ice cream"
          class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100"
        />
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        How much did it cost?
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-blue-400 focus-within:ring-2 focus-within:ring-blue-100">
          <span class="font-bold text-slate-400">$</span>
          <input
            id="purchase-amount"
            name="amount"
            type="number"
            min="0.01"
            step="0.01"
            inputmode="decimal"
            required
            placeholder="4.50"
            class="min-w-0 w-full bg-transparent px-2 py-3 outline-none"
          />
        </span>
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Which bucket should pay for it?
        <select
          id="purchase-bucket"
          name="bucket"
          class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 outline-none transition focus:border-blue-400 focus:ring-2 focus:ring-blue-100"
        >
          <option value="spending">🛒 Spending</option>
          <option value="saving">🎯 Saving</option>
          <option value="giving">❤️ Giving</option>
        </select>
      </label>

      <p
        id="purchase-balance-help"
        class="mt-3 text-sm text-slate-500"
      ></p>

      <p
        id="purchase-error"
        class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"
      ></p>

      <button
        type="submit"
        class="mt-6 w-full rounded-xl bg-blue-600 px-5 py-3 font-bold text-white transition hover:bg-blue-700"
      >
        Send for Parent Approval
      </button>
    </form>
  </dialog>

  <dialog
    id="new-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="new-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
            New savings goal
          </p>
          <h2 class="mt-1 text-2xl font-black">What are you saving for?</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Pick something exciting and set the amount you need.
          </p>
        </div>
        <button id="close-new-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <fieldset class="mt-6">
        <legend class="text-sm font-bold text-slate-700">
          Choose an icon
        </legend>

        <div class="mt-3 flex items-center gap-4 rounded-2xl bg-emerald-50 p-4 ring-1 ring-emerald-100">
          <div
            id="selected-goal-emoji"
            class="grid h-16 w-16 shrink-0 place-items-center rounded-2xl bg-white text-4xl shadow-sm ring-2 ring-emerald-500"
            aria-hidden="true"
          >
            🎯
          </div>

          <div>
            <strong class="block text-slate-900">Selected icon</strong>
            <span class="mt-1 block text-sm text-slate-500">
              Tap any emoji below to change it.
            </span>
          </div>
        </div>

        <input
          id="goal-emoji-input"
          name="emoji"
          type="hidden"
          value="🎯"
        />

        <div
          id="goal-emoji-picker"
          class="mt-4 grid grid-cols-6 gap-2 sm:grid-cols-8"
          aria-label="Choose a goal icon"
        ></div>
      </fieldset>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Goal name
        <input name="name" type="text" maxlength="80" required placeholder="Nintendo Switch Game" class="mt-2 w-full rounded-xl border border-slate-200 px-4 py-3 outline-none transition focus:border-emerald-400 focus:ring-2 focus:ring-emerald-100" />
      </label>

      <label class="mt-4 block text-sm font-bold text-slate-700">
        Target price
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="target" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="60.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <p id="new-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700">Create Goal</button>
    </form>
  </dialog>

  <dialog
    id="allocate-goal-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="allocate-goal-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">Allocate savings</p>
          <h2 id="allocate-goal-title" class="mt-1 text-2xl font-black">Add money to goal</h2>
          <p id="allocate-goal-help" class="mt-2 text-sm leading-6 text-slate-500"></p>
        </div>
        <button id="close-allocate-goal-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <label class="mt-6 block text-sm font-bold text-slate-700">
        Amount to add
        <span class="mt-2 flex items-center rounded-xl border border-slate-200 px-4 transition focus-within:border-emerald-400 focus-within:ring-2 focus-within:ring-emerald-100">
          <span class="font-bold text-slate-400">$</span>
          <input name="amount" type="number" min="0.01" step="0.01" inputmode="decimal" required placeholder="5.00" class="min-w-0 w-full bg-transparent px-2 py-3 outline-none" />
        </span>
      </label>

      <input id="allocate-goal-id" name="goalId" type="hidden" />
      <p id="allocate-goal-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700">Add to Goal</button>
    </form>
  </dialog>

  <div
    id="prototype-toast"
    class="pointer-events-none fixed bottom-5 left-1/2 z-50 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 translate-y-5 rounded-2xl bg-slate-950 px-5 py-4 text-center text-sm font-bold text-white opacity-0 shadow-2xl transition-all duration-200"
    role="status"
    aria-live="polite"
  ></div>

  <script
    type="application/json"
    id="demo-kids"
    set:html={demoJson}
  ></script>

  <script>
    import type {
      BucketType,
      FamilyBankState,
      Kid,
      Transaction,
    } from "../../types";

    import {
      allocateToGoal,
      createGoal,
      createPurchaseRequest,
      loadState,
      saveState,
    } from "../../lib/store";

    const dashboard = document.querySelector(
      "#kid-dashboard",
    );

    const demoElement = document.querySelector(
      "#demo-kids",
    );

    const toast = document.querySelector(
      "#prototype-toast",
    );

    const purchaseDialog = document.querySelector(
      "#purchase-dialog",
    );

    const purchaseForm = document.querySelector(
      "#purchase-form",
    );

    const closePurchaseDialog = document.querySelector(
      "#close-purchase-dialog",
    );

    const purchaseBucket = document.querySelector(
      "#purchase-bucket",
    );

    const purchaseBalanceHelp = document.querySelector(
      "#purchase-balance-help",
    );

    const purchaseError = document.querySelector(
      "#purchase-error",
    );

    const newGoalDialog = document.querySelector(
      "#new-goal-dialog",
    );
    const newGoalForm = document.querySelector(
      "#new-goal-form",
    );
    const closeNewGoalDialog = document.querySelector(
      "#close-new-goal-dialog",
    );
    const newGoalError = document.querySelector(
      "#new-goal-error",
    );
    const goalEmojiPicker = document.querySelector(
      "#goal-emoji-picker",
    );
    const goalEmojiInput = document.querySelector(
      "#goal-emoji-input",
    );
    const selectedGoalEmoji = document.querySelector(
      "#selected-goal-emoji",
    );

    const allocateGoalDialog = document.querySelector(
      "#allocate-goal-dialog",
    );
    const allocateGoalForm = document.querySelector(
      "#allocate-goal-form",
    );
    const closeAllocateGoalDialog = document.querySelector(
      "#close-allocate-goal-dialog",
    );
    const allocateGoalTitle = document.querySelector(
      "#allocate-goal-title",
    );
    const allocateGoalHelp = document.querySelector(
      "#allocate-goal-help",
    );
    const allocateGoalId = document.querySelector(
      "#allocate-goal-id",
    );
    const allocateGoalError = document.querySelector(
      "#allocate-goal-error",
    );

    let toastTimeout: number | undefined;

    const money = new Intl.NumberFormat(
      "en-US",
      {
        style: "currency",
        currency: "USD",
      },
    );

    const dateFormatter = new Intl.DateTimeFormat(
      "en-US",
      {
        month: "short",
        day: "numeric",
      },
    );

    const bucketMeta: Record<
      BucketType,
      {
        label: string;
        icon: string;
        card: string;
        iconClass: string;
        labelClass: string;
        amountClass: string;
        badge: string;
      }
    > = {
      spending: {
        label: "Spending",
        icon: "🛒",
        card: "bg-blue-50 ring-blue-100",
        iconClass: "bg-blue-100",
        labelClass: "text-blue-700",
        amountClass: "text-blue-950",
        badge: "bg-blue-50 text-blue-700",
      },
      saving: {
        label: "Saving",
        icon: "🎯",
        card: "bg-emerald-50 ring-emerald-100",
        iconClass: "bg-emerald-100",
        labelClass: "text-emerald-700",
        amountClass: "text-emerald-950",
        badge: "bg-emerald-50 text-emerald-700",
      },
      giving: {
        label: "Giving",
        icon: "❤️",
        card: "bg-amber-50 ring-amber-100",
        iconClass: "bg-amber-100",
        labelClass: "text-amber-700",
        amountClass: "text-amber-950",
        badge: "bg-amber-50 text-amber-700",
      },
    };

    const goalEmojis = [
      "🎯", "🎮", "🧱", "🎲", "🃏", "🧸",
      "⚽️", "🏀", "🏈", "⚾️", "🎾", "🏒",
      "🚲", "🛴", "🛹", "🚗", "✈️", "🚀",
      "🎸", "🎹", "🎧", "🎤", "🥁", "🎨",
      "💻", "📱", "⌚️", "📷", "🎥", "🕹️",
      "🐶", "🐱", "🦖", "🐠", "🐴", "🦜",
      "🍕", "🍦", "🍩", "🍪", "🍿", "🧁",
      "🎁", "🎉", "📚", "🏕️", "🏖️", "⭐️",
    ];

    const transactionIcons: Record<
      Transaction["type"],
      string
    > = {
      allowance: "💰",
      purchase: "🛍️",
      transfer: "↔️",
      goal: "🎯",
      adjustment: "✏️",
    };

    function setSelectedGoalEmoji(emoji: string): void {
      if (goalEmojiInput instanceof HTMLInputElement) {
        goalEmojiInput.value = emoji;
      }

      if (selectedGoalEmoji instanceof HTMLElement) {
        selectedGoalEmoji.textContent = emoji;
      }

      goalEmojiPicker
        ?.querySelectorAll<HTMLButtonElement>("[data-goal-emoji]")
        .forEach((button) => {
          const selected = button.dataset.goalEmoji === emoji;

          button.classList.toggle("bg-emerald-600", selected);
          button.classList.toggle("ring-2", selected);
          button.classList.toggle("ring-emerald-700", selected);
          button.classList.toggle("scale-105", selected);
          button.classList.toggle("bg-slate-100", !selected);
          button.classList.toggle("hover:bg-slate-200", !selected);
          button.setAttribute("aria-pressed", String(selected));
        });
    }

    function renderGoalEmojiPicker(): void {
      if (!(goalEmojiPicker instanceof HTMLElement)) {
        return;
      }

      goalEmojiPicker.innerHTML = goalEmojis
        .map(
          (emoji) => `
            <button
              type="button"
              data-goal-emoji="${emoji}"
              class="grid aspect-square min-h-11 place-items-center rounded-xl bg-slate-100 text-2xl transition hover:-translate-y-0.5 hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
              aria-label="Choose ${emoji}"
              aria-pressed="false"
            >
              ${emoji}
            </button>
          `,
        )
        .join("");

      goalEmojiPicker
        .querySelectorAll<HTMLButtonElement>("[data-goal-emoji]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const emoji = button.dataset.goalEmoji;
            if (emoji) {
              setSelectedGoalEmoji(emoji);
            }
          });
        });

      setSelectedGoalEmoji("🎯");
    }

    function escapeHtml(value: string): string {
      const element = document.createElement("div");
      element.textContent = value;
      return element.innerHTML;
    }

    function formatDate(value: string): string {
      return dateFormatter.format(
        new Date(`${value}T12:00:00`),
      );
    }

    function showToast(message: string): void {
      if (!(toast instanceof HTMLElement)) {
        return;
      }

      window.clearTimeout(toastTimeout);

      toast.textContent = message;
      toast.classList.remove(
        "translate-y-5",
        "opacity-0",
      );
      toast.classList.add(
        "translate-y-0",
        "opacity-100",
      );

      toastTimeout = window.setTimeout(() => {
        toast.classList.remove(
          "translate-y-0",
          "opacity-100",
        );
        toast.classList.add(
          "translate-y-5",
          "opacity-0",
        );
      }, 2600);
    }

    function renderBucket(
      bucket: BucketType,
      amount: number,
    ): string {
      const meta = bucketMeta[bucket];

      return `
        <article class="min-w-0 rounded-2xl p-4 ring-1 sm:p-5 ${meta.card}">
          <div class="grid h-10 w-10 place-items-center rounded-xl text-xl ${meta.iconClass}" aria-hidden="true">
            ${meta.icon}
          </div>

          <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.12em] ${meta.labelClass}">
            ${meta.label}
          </p>

          <p class="mt-1 truncate text-xl font-black tracking-tight sm:text-2xl ${meta.amountClass}">
            ${money.format(amount)}
          </p>
        </article>
      `;
    }

    function renderGoals(kid: Kid): string {
      if (kid.goals.length === 0) {
        return `
          <div class="rounded-3xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
            <div class="text-4xl" aria-hidden="true">🎯</div>
            <h3 class="mt-3 text-lg font-black">No goals yet</h3>
            <p class="mt-2 text-sm leading-6 text-slate-500">
              Create a goal for something you would like to save for.
            </p>
          </div>
        `;
      }

      return kid.goals
        .map((goal) => {
          const percent = Math.min(
            100,
            Math.max(
              0,
              goal.target > 0
                ? (goal.saved / goal.target) * 100
                : 0,
            ),
          );

          const remaining = Math.max(
            0,
            goal.target - goal.saved,
          );

          return `
            <article class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200/80 sm:p-6">
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-emerald-50 text-2xl" aria-hidden="true">
                    ${escapeHtml(goal.emoji)}
                  </div>

                  <div class="min-w-0">
                    <h3 class="truncate text-lg font-black text-slate-950">
                      ${escapeHtml(goal.name)}
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                      <strong class="font-bold text-slate-700">
                        ${money.format(goal.saved)}
                      </strong>
                      of ${money.format(goal.target)}
                    </p>
                  </div>
                </div>

                <span class="shrink-0 rounded-full bg-emerald-50 px-3 py-1 text-sm font-extrabold text-emerald-700">
                  ${Math.round(percent)}%
                </span>
              </div>

              <div class="mt-5 h-3 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="${escapeHtml(goal.name)} savings progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(percent)}">
                <div class="h-full rounded-full bg-emerald-500 transition-all duration-500" style="width: ${percent}%"></div>
              </div>

              <div class="mt-4 flex items-center justify-between gap-4">
                <p class="text-sm text-slate-500">
                  ${remaining === 0 ? "Goal complete! 🎉" : `${money.format(remaining)} left to go`}
                </p>

                <button
                  type="button"
                  class="inline-flex min-h-10 items-center justify-center rounded-xl px-4 text-sm font-bold transition focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 ${remaining === 0 ? "cursor-default bg-emerald-50 text-emerald-700" : "bg-emerald-600 text-white hover:bg-emerald-700"}"
                  ${remaining === 0 ? "disabled" : `data-goal-id="${goal.id}"`}
                >
                  ${remaining === 0 ? "Complete 🎉" : "Add money"}
                </button>
              </div>
            </article>
          `;
        })
        .join("");
    }

    function renderActivity(kid: Kid): string {
      const recent = kid.transactions.slice(0, 8);

      if (recent.length === 0) {
        return `
          <div class="p-8 text-center">
            <div class="text-4xl" aria-hidden="true">📋</div>
            <h3 class="mt-3 font-black">No activity yet</h3>
            <p class="mt-2 text-sm text-slate-500">
              Allowance payments and purchases will appear here.
            </p>
          </div>
        `;
      }

      return recent
        .map((transaction) => {
          const meta = bucketMeta[transaction.bucket];
          const amountClass =
            transaction.amount >= 0
              ? "text-emerald-600"
              : "text-slate-900";
          const sign =
            transaction.amount > 0
              ? "+"
              : transaction.amount < 0
                ? "-"
                : "";

          return `
            <article class="flex items-center gap-4 p-4 sm:p-5">
              <div class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-slate-100 text-xl" aria-hidden="true">
                ${transactionIcons[transaction.type]}
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="truncate text-sm font-black text-slate-900 sm:text-base">
                  ${escapeHtml(transaction.description)}
                </h3>

                <div class="mt-1 flex flex-wrap items-center gap-2">
                  <span class="rounded-full px-2 py-0.5 text-xs font-bold ${meta.badge}">
                    ${meta.label}
                  </span>

                  <span class="text-xs text-slate-400">
                    ${formatDate(transaction.date)}
                  </span>
                </div>
              </div>

              <strong class="shrink-0 text-sm font-black sm:text-base ${amountClass}">
                ${sign}${money.format(Math.abs(transaction.amount))}
              </strong>
            </article>
          `;
        })
        .join("");
    }

    function renderDashboard(kid: Kid): void {
      if (!(dashboard instanceof HTMLElement)) {
        return;
      }

      const baseUrl = dashboard.dataset.baseUrl ?? "/";
      const total =
        kid.buckets.spending +
        kid.buckets.saving +
        kid.buckets.giving;

      const allocatedSavings = kid.goals.reduce(
        (sum, goal) => sum + goal.saved,
        0,
      );

      const unallocatedSavings = Math.max(
        0,
        kid.buckets.saving - allocatedSavings,
      );

      dashboard.innerHTML = `
        <header class="mb-6 flex items-center justify-between gap-4">
          <div class="flex items-center gap-4">
            <div class="grid h-14 w-14 place-items-center rounded-2xl bg-white text-3xl shadow-sm ring-1 ring-slate-200" aria-hidden="true">
              ${escapeHtml(kid.emoji)}
            </div>

            <div>
              <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">
                My account
              </p>

              <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
                ${escapeHtml(kid.name)}
              </h1>
            </div>
          </div>

          <a
            href="${baseUrl}"
            class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-4 text-sm font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Switch
          </a>
        </header>

        <section class="overflow-hidden rounded-[2rem] bg-slate-950 text-white shadow-xl shadow-slate-300/60">
          <div class="p-7 sm:p-9">
            <div class="flex items-start justify-between gap-6">
              <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.22em] text-slate-400">
                  Total balance
                </p>

                <div class="mt-3 text-5xl font-black tracking-tight sm:text-6xl">
                  ${money.format(total)}
                </div>
              </div>

              <div class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-white/10 text-2xl" aria-hidden="true">
                💰
              </div>
            </div>

            <div class="mt-7 rounded-2xl bg-white/10 p-4 ring-1 ring-white/10">
              <p class="text-sm leading-6 text-slate-200">
                ${
                  unallocatedSavings > 0
                    ? `You have <strong class="text-white">${money.format(unallocatedSavings)}</strong> in Saving that can be added to a goal.`
                    : "Every dollar has a job. Nice work keeping your money organized."
                }
              </p>
            </div>
          </div>
        </section>

        <section class="mt-6">
          <div class="grid grid-cols-3 gap-2 sm:gap-4">
            ${renderBucket("spending", kid.buckets.spending)}
            ${renderBucket("saving", kid.buckets.saving)}
            ${renderBucket("giving", kid.buckets.giving)}
          </div>
        </section>

        <section class="mt-10">
          <div class="mb-4 flex items-end justify-between gap-4">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
                Saving
              </p>

              <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">
                My goals
              </h2>
            </div>

            <button
              type="button"
              class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-4 text-sm font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500"
              data-new-goal
            >
              + New goal
            </button>
          </div>

          <div class="grid gap-4">
            ${renderGoals(kid)}
          </div>
        </section>

        <section class="mt-10">
          <div class="mb-4">
            <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
              Money tools
            </p>

            <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">
              What would you like to do?
            </h2>
          </div>

          <div class="grid gap-3 sm:grid-cols-3">
            <button type="button" data-action="purchase" class="group flex w-full items-center gap-4 rounded-2xl bg-white p-5 text-left shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-blue-50 text-2xl" aria-hidden="true">💸</span>
              <span class="min-w-0 flex-1"><span class="block text-base font-black text-slate-950">I Bought Something</span><span class="mt-1 block text-sm text-slate-500">Record a purchase</span></span>
              <span class="text-2xl font-light text-slate-300">→</span>
            </button>

            <button type="button" data-action="move" class="group flex w-full items-center gap-4 rounded-2xl bg-white p-5 text-left shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-violet-50 text-2xl" aria-hidden="true">↔️</span>
              <span class="min-w-0 flex-1"><span class="block text-base font-black text-slate-950">Move Money</span><span class="mt-1 block text-sm text-slate-500">Change your buckets</span></span>
              <span class="text-2xl font-light text-slate-300">→</span>
            </button>

            <button type="button" data-action="afford" class="group flex w-full items-center gap-4 rounded-2xl bg-white p-5 text-left shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-500">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-2xl bg-orange-50 text-2xl" aria-hidden="true">🧮</span>
              <span class="min-w-0 flex-1"><span class="block text-base font-black text-slate-950">Can I Buy It?</span><span class="mt-1 block text-sm text-slate-500">Check before spending</span></span>
              <span class="text-2xl font-light text-slate-300">→</span>
            </button>
          </div>
        </section>

        <section class="mt-10">
          <div class="mb-4">
            <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-slate-500">
              Account history
            </p>

            <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">
              Recent activity
            </h2>
          </div>

          <div class="divide-y divide-slate-100 overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200/80">
            ${renderActivity(kid)}
          </div>
        </section>

        <footer class="mt-12 pb-4 text-center text-sm text-slate-400">
          The Family Bank · Spend, save, and give wisely.
        </footer>
      `;

      attachActionListeners();
    }

    let currentKid: Kid | null = null;
    let currentState: FamilyBankState | null = null;

    function updatePurchaseBalanceHelp(): void {
      if (
        !currentKid ||
        !(purchaseBucket instanceof HTMLSelectElement) ||
        !(purchaseBalanceHelp instanceof HTMLElement)
      ) {
        return;
      }

      const bucket = purchaseBucket.value as BucketType;
      const meta = bucketMeta[bucket];

      purchaseBalanceHelp.textContent =
        `${meta.icon} ${meta.label} balance: ${money.format(currentKid.buckets[bucket])}`;
    }

    function openPurchaseDialog(): void {
      if (!(purchaseDialog instanceof HTMLDialogElement)) {
        return;
      }

      if (purchaseError instanceof HTMLElement) {
        purchaseError.classList.add("hidden");
        purchaseError.textContent = "";
      }

      updatePurchaseBalanceHelp();
      purchaseDialog.showModal();

      window.setTimeout(() => {
        document
          .querySelector<HTMLInputElement>(
            "#purchase-description",
          )
          ?.focus();
      }, 0);
    }

    function openNewGoalDialog(): void {
      if (!(newGoalDialog instanceof HTMLDialogElement)) return;
      if (newGoalError instanceof HTMLElement) {
        newGoalError.classList.add("hidden");
        newGoalError.textContent = "";
      }
      if (newGoalForm instanceof HTMLFormElement) newGoalForm.reset();
      setSelectedGoalEmoji("🎯");
      newGoalDialog.showModal();
      window.setTimeout(() => newGoalForm?.querySelector<HTMLInputElement>('[name="name"]')?.focus(), 0);
    }

    function openAllocateGoalDialog(goalId: string): void {
      if (!currentKid || !(allocateGoalDialog instanceof HTMLDialogElement)) return;
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) return;

      const allocated = currentKid.goals.reduce((sum, item) => sum + item.saved, 0);
      const available = Math.max(0, currentKid.buckets.saving - allocated);
      const remaining = Math.max(0, goal.target - goal.saved);

      if (allocateGoalTitle instanceof HTMLElement) {
        allocateGoalTitle.textContent = `Add to ${goal.name}`;
      }
      if (allocateGoalHelp instanceof HTMLElement) {
        allocateGoalHelp.textContent = `${money.format(available)} is available to allocate. This goal needs ${money.format(remaining)} more.`;
      }
      if (allocateGoalId instanceof HTMLInputElement) allocateGoalId.value = goal.id;
      if (allocateGoalError instanceof HTMLElement) {
        allocateGoalError.classList.add("hidden");
        allocateGoalError.textContent = "";
      }
      if (allocateGoalForm instanceof HTMLFormElement) {
        const amount = allocateGoalForm.querySelector<HTMLInputElement>('[name="amount"]');
        if (amount) amount.value = "";
      }
      allocateGoalDialog.showModal();
      window.setTimeout(() => allocateGoalForm?.querySelector<HTMLInputElement>('[name="amount"]')?.focus(), 0);
    }

    function attachActionListeners(): void {
      document
        .querySelector<HTMLElement>(
          '[data-action="purchase"]',
        )
        ?.addEventListener(
          "click",
          openPurchaseDialog,
        );

      document
        .querySelector<HTMLElement>(
          '[data-action="move"]',
        )
        ?.addEventListener("click", () => {
          showToast(
            "The Move Money screen is coming next.",
          );
        });

      document
        .querySelector<HTMLElement>(
          '[data-action="afford"]',
        )
        ?.addEventListener("click", () => {
          showToast(
            "The Can I Buy It calculator is coming next.",
          );
        });

      document
        .querySelectorAll<HTMLElement>("[data-goal-id]")
        .forEach((button) => {
          button.addEventListener("click", () => {
            const goalId = button.dataset.goalId;
            if (goalId) openAllocateGoalDialog(goalId);
          });
        });

      document
        .querySelector<HTMLElement>("[data-new-goal]")
        ?.addEventListener("click", openNewGoalDialog);
    }

    closePurchaseDialog?.addEventListener(
      "click",
      () => {
        if (purchaseDialog instanceof HTMLDialogElement) {
          purchaseDialog.close();
        }
      },
    );

    purchaseDialog?.addEventListener(
      "click",
      (event) => {
        if (
          purchaseDialog instanceof HTMLDialogElement &&
          event.target === purchaseDialog
        ) {
          purchaseDialog.close();
        }
      },
    );

    purchaseBucket?.addEventListener(
      "change",
      updatePurchaseBalanceHelp,
    );

    purchaseForm?.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();

        if (
          !(purchaseForm instanceof HTMLFormElement) ||
          !currentState ||
          !currentKid
        ) {
          return;
        }

        const formData = new FormData(purchaseForm);
        const description = String(
          formData.get("description") ?? "",
        );
        const amount = Number(formData.get("amount"));
        const bucket = formData.get("bucket") as BucketType;

        try {
          createPurchaseRequest(
            currentState,
            currentKid.slug,
            description,
            amount,
            bucket,
          );

          saveState(currentState);
          purchaseForm.reset();

          if (purchaseDialog instanceof HTMLDialogElement) {
            purchaseDialog.close();
          }

          showToast(
            "Request sent for parent approval! ⏳",
          );
        } catch (error) {
          if (purchaseError instanceof HTMLElement) {
            purchaseError.textContent =
              error instanceof Error
                ? error.message
                : "Unable to send the purchase request.";
            purchaseError.classList.remove("hidden");
          }
        }
      },
    );

    closeNewGoalDialog?.addEventListener("click", () => {
      if (newGoalDialog instanceof HTMLDialogElement) newGoalDialog.close();
    });

    newGoalDialog?.addEventListener("click", (event) => {
      if (newGoalDialog instanceof HTMLDialogElement && event.target === newGoalDialog) newGoalDialog.close();
    });

    closeAllocateGoalDialog?.addEventListener("click", () => {
      if (allocateGoalDialog instanceof HTMLDialogElement) allocateGoalDialog.close();
    });

    allocateGoalDialog?.addEventListener("click", (event) => {
      if (allocateGoalDialog instanceof HTMLDialogElement && event.target === allocateGoalDialog) allocateGoalDialog.close();
    });

    newGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(newGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(newGoalForm);
      try {
        createGoal(
          currentState,
          currentKid.slug,
          String(data.get("name") ?? ""),
          Number(data.get("target")),
          String(data.get("emoji") ?? "🎯"),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        newGoalDialog instanceof HTMLDialogElement && newGoalDialog.close();
        showToast("New savings goal created! 🎯");
      } catch (error) {
        if (newGoalError instanceof HTMLElement) {
          newGoalError.textContent = error instanceof Error ? error.message : "Unable to create the goal.";
          newGoalError.classList.remove("hidden");
        }
      }
    });

    allocateGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(allocateGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(allocateGoalForm);
      try {
        allocateToGoal(
          currentState,
          currentKid.slug,
          String(data.get("goalId") ?? ""),
          Number(data.get("amount")),
        );
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        allocateGoalDialog instanceof HTMLDialogElement && allocateGoalDialog.close();
        showToast("Savings added to your goal! 🎉");
      } catch (error) {
        if (allocateGoalError instanceof HTMLElement) {
          allocateGoalError.textContent = error instanceof Error ? error.message : "Unable to add money to the goal.";
          allocateGoalError.classList.remove("hidden");
        }
      }
    });

    renderGoalEmojiPicker();

    if (
      dashboard instanceof HTMLElement &&
      demoElement instanceof HTMLElement
    ) {
      const slug =
        dashboard.dataset.kidSlug ?? "";

      const demoKids = JSON.parse(
        demoElement.textContent || "{}",
      ) as Record<string, Kid>;

      const state: FamilyBankState =
        loadState(demoKids);

      const savedKid = state.kids[slug];

      currentState = state;
      currentKid = savedKid ?? demoKids[slug] ?? null;

      if (savedKid) {
        renderDashboard(savedKid);
      } else {
        attachActionListeners();
      }

      updatePurchaseBalanceHelp();
    }
  </script>
</Layout>
