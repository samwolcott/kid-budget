      }
    });

    confirmCompleteGoal?.addEventListener("click", () => {
      if (!currentState || !currentKid || !selectedGoalId) return;
      try {
        completeGoalPurchase(currentState, currentKid.slug, selectedGoalId);
        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        completeGoalDialog instanceof HTMLDialogElement && completeGoalDialog.close();
        showToast("Goal purchased! Nice saving! 🎉");
        celebrate();
      } catch (error) {
        window.alert(error instanceof Error ? error.message : "Unable to complete the purchase.");
      }
    });

    renderGoalEmojiPicker();
    renderEditGoalEmojiPicker();

    if (
      dashboard instanceof HTMLElement &&
      demoElement instanceof HTMLElement
    ) {
      const slug =
        dashboard.dataset.kidSlug ?? "";

      const demoKids = JSON.parse(
        demoElement.textContent || "{}",
      ) as Record<string, Kid>;

      const state: FamilyBankState =
        loadState(demoKids);

      const savedKid = state.kids[slug];

      currentState = state;
      currentKid = savedKid ?? demoKids[slug] ?? null;

      if (savedKid) {
        renderDashboard(savedKid);
      } else {
        attachActionListeners();
      }

      updatePurchaseBalanceHelp();
    }
  </script>
</Layout>
