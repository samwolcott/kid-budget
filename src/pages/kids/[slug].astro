    cancelCompleteGoal?.addEventListener("click", () => {
      if (completeGoalDialog instanceof HTMLDialogElement) completeGoalDialog.close();
    });
    completeGoalDialog?.addEventListener("click", (event) => {
      if (completeGoalDialog instanceof HTMLDialogElement && event.target === completeGoalDialog) completeGoalDialog.close();
    });

    removeGoalForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!(removeGoalForm instanceof HTMLFormElement) || !currentState || !currentKid) return;
      const data = new FormData(removeGoalForm);
      try {
        removeFromGoal(
          currentState,
