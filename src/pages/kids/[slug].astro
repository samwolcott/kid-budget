        saveState(currentState);
        currentKid = currentState.kids[currentKid.slug];
        renderDashboard(currentKid);
        removeGoalDialog instanceof HTMLDialogElement && removeGoalDialog.close();
        showToast("Money returned to Available Saving! ↩️");
