    function updateEditGoalButton(): void {
      if (!currentKid || !(saveEditGoal instanceof HTMLButtonElement)) return;
      const goalId = editGoalId instanceof HTMLInputElement ? editGoalId.value : "";
      const goal = currentKid.goals.find((item) => item.id === goalId);
      if (!goal) {
        saveEditGoal.disabled = true;
        return;
      }

      const name = editGoalName instanceof HTMLInputElement ? editGoalName.value.trim() : "";
      const target = editGoalTarget instanceof HTMLInputElement ? Number(editGoalTarget.value) : 0;
      const emoji = editGoalEmojiInput instanceof HTMLInputElement ? editGoalEmojiInput.value : "🎯";
      const changed = name !== goal.name || target !== goal.target || emoji !== goal.emoji;
      const valid = name.length > 0 && Number.isFinite(target) && target >= goal.saved && target > 0;
      saveEditGoal.disabled = !changed || !valid;
    }

    function escapeHtml(value: string): string {
      const element = document.createElement("div");
      element.textContent = value;
      return element.innerHTML;
    }

    function formatDate(value: string): string {
      return dateFormatter.format(
        new Date(`${value}T12:00:00`),
      );
    }

    function showToast(message: string): void {
      if (!(toast instanceof HTMLElement)) {
        return;
      }

      window.clearTimeout(toastTimeout);

      toast.textContent = message;
      toast.classList.remove(
        "translate-y-5",
        "opacity-0",
      );
      toast.classList.add(
        "translate-y-0",
        "opacity-100",
      );

      toastTimeout = window.setTimeout(() => {
        toast.classList.remove(
          "translate-y-0",
          "opacity-100",
        );
        toast.classList.add(
          "translate-y-5",
          "opacity-0",
        );
      }, 2600);
    }

    function celebrate(): void {
      if (
        !(confetti instanceof HTMLElement) ||
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) return;

      const colors = [
        "#2563eb",
        "#10b981",
        "#f59e0b",
        "#8b5cf6",
        "#ec4899",
      ];
      const pieces = document.createDocumentFragment();

      for (let index = 0; index < 44; index += 1) {
        const piece = document.createElement("span");
        piece.className = "confetti-piece";
        piece.style.backgroundColor = colors[index % colors.length];
        piece.style.setProperty("--confetti-x", `${Math.random() * 100}%`);
        piece.style.setProperty("--confetti-drift", `${Math.random() * 160 - 80}px`);
        piece.style.setProperty("--confetti-turn", `${Math.random() * 720 + 360}deg`);
        piece.style.setProperty("--confetti-delay", `${Math.random() * 0.35}s`);
        piece.style.setProperty("--confetti-duration", `${Math.random() * 0.8 + 1.8}s`);
        if (index % 3 === 0) piece.classList.add("rounded-full");
        pieces.append(piece);
      }

      window.clearTimeout(confettiTimeout);
      confetti.replaceChildren(pieces);
      confettiTimeout = window.setTimeout(() => {
        confetti.replaceChildren();
      }, 3200);
    }

