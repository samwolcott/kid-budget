---
import Layout from "../../layouts/Layout.astro";
import AuthPanel from "../../components/parent/AuthPanel.astro";
import ProfileControls from "../../components/ProfileControls.astro";
import { kids as demoKids } from "../../data/demo";

const demoJson = JSON.stringify(demoKids);
---

<Layout title="Parent Dashboard | The Family Bank" profile="parent">
  <main class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-10">
    <AuthPanel />

    <header class="mb-8 flex items-end justify-between gap-4">
      <div>
        <a
          href={`${import.meta.env.BASE_URL}`}
          class="text-sm font-bold text-slate-500"
        >
          ← The Family Bank
        </a>

        <p class="mt-5 text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
          Parent dashboard
        </p>

        <h1 class="mt-1 text-4xl font-black">
          Family accounts
        </h1>
      </div>

      <ProfileControls profile="parent" />
    </header>

    <section aria-labelledby="overview-heading">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
        Overview
      </p>

      <h2 id="overview-heading" class="mt-1 text-2xl font-black">
        Family at a glance
      </h2>

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        <article class="rounded-2xl bg-blue-50 p-5 ring-1 ring-blue-100">
          <div class="grid h-10 w-10 place-items-center rounded-xl bg-blue-100 text-xl" aria-hidden="true">
            💰
          </div>
          <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.12em] text-blue-700">
            Family balance
          </p>
          <p id="family-balance" class="mt-1 text-2xl font-black text-blue-950">
            $0.00
          </p>
        </article>

        <article class="rounded-2xl bg-emerald-50 p-5 ring-1 ring-emerald-100">
          <div class="grid h-10 w-10 place-items-center rounded-xl bg-emerald-100 text-xl" aria-hidden="true">
            👥
          </div>
          <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.12em] text-emerald-700">
            Kid accounts
          </p>
          <p id="kid-count" class="mt-1 text-2xl font-black text-emerald-950">
            0
          </p>
        </article>

        <article class="rounded-2xl bg-amber-50 p-5 ring-1 ring-amber-100">
          <div class="grid h-10 w-10 place-items-center rounded-xl bg-amber-100 text-xl" aria-hidden="true">
            🔔
          </div>
          <p class="mt-4 text-xs font-extrabold uppercase tracking-[0.12em] text-amber-700">
            Needs review
          </p>
          <p id="overview-request-count" class="mt-1 text-2xl font-black text-amber-950">
            0 requests
          </p>
        </article>
      </div>
    </section>

    <section class="mt-10 rounded-3xl bg-slate-950 p-6 text-white sm:p-8">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-slate-400">
        Allowance
      </p>

      <div class="mt-2 flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-2xl font-black">
            Pay allowance
          </h2>

          <p
            id="current-split-summary"
            class="mt-1 text-sm text-slate-300"
          >
            70% Spending · 20% Saving · 10% Giving
          </p>
        </div>

        <button
          id="allowance-button"
          type="button"
          class="rounded-xl bg-white px-5 py-3 font-bold text-slate-950 transition hover:bg-slate-100"
        >
          Pay Allowance
        </button>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="savings-heading">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
        Saving
      </p>

      <div class="mt-1 flex flex-wrap items-end justify-between gap-3">
        <h2 id="savings-heading" class="text-2xl font-black">
          Savings overview
        </h2>

        <p id="family-savings-summary" class="text-sm font-bold text-emerald-700">
          $0.00 available
        </p>
      </div>

      <div id="savings-overview" class="mt-4 grid gap-4 sm:grid-cols-2"></div>
    </section>

    <section class="mt-10">
      <div class="flex items-end justify-between">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-amber-600">
            Needs your attention
          </p>

          <h2 class="mt-1 text-2xl font-black">
            Purchase requests
          </h2>
        </div>

        <span
          id="request-count"
          class="rounded-full bg-amber-50 px-3 py-1 text-sm font-bold text-amber-700"
        >
          0 pending
        </span>
      </div>

      <div
        id="request-list"
        class="mt-4 grid gap-3"
      ></div>
    </section>

    <section class="mt-10">
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
        Accounts
      </p>

      <h2 class="mt-1 text-2xl font-black">
        Judah and Max
      </h2>

      <div
        id="kid-list"
        class="mt-4 grid gap-4 sm:grid-cols-2"
      ></div>
    </section>
  </main>

  <dialog
    id="allowance-dialog"
    class="fixed inset-0 m-auto max-h-[calc(100vh-2rem)] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form
      id="allowance-form"
      class="p-5 sm:p-7"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
            Payday
          </p>

          <h2 class="mt-1 text-3xl font-black">
            Pay allowance
          </h2>

          <p class="mt-2 text-sm leading-6 text-slate-500">
            Choose who gets paid, adjust each amount, and decide how today's allowance is divided.
          </p>
        </div>

        <button
          id="close-allowance-dialog"
          type="button"
          class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200"
          aria-label="Close"
        >
          ×
        </button>
      </div>

      <section class="mt-7">
        <h3 class="text-lg font-black">
          Who is getting paid today?
        </h3>

        <div
          id="allowance-kids"
          class="mt-3 grid gap-3"
        ></div>
      </section>

      <section class="mt-7 border-t border-slate-200 pt-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-lg font-black">
            How should we split it?
          </h3>

          <span class="text-xs font-bold text-emerald-700">
            Remembers your last split
          </span>
        </div>

        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          <label class="rounded-2xl bg-blue-50 p-4 ring-1 ring-blue-100">
            <span class="block text-sm font-bold text-blue-700">
              Spending
            </span>

            <span class="mt-2 flex items-center gap-2">
              <input
                id="spending-percent"
                name="spendingPercent"
                type="number"
                min="0"
                max="100"
                step="1"
                inputmode="numeric"
                class="min-w-0 flex-1 rounded-xl border border-blue-200 bg-white px-3 py-2 text-lg font-black text-blue-950 outline-none focus:ring-2 focus:ring-blue-500"
                value="70"
              />

              <span class="font-black text-blue-900">
                %
              </span>
            </span>
          </label>

          <label class="rounded-2xl bg-emerald-50 p-4 ring-1 ring-emerald-100">
            <span class="block text-sm font-bold text-emerald-700">
              Saving
            </span>

            <span class="mt-2 flex items-center gap-2">
              <input
                id="saving-percent"
                name="savingPercent"
                type="number"
                min="0"
                max="100"
                step="1"
                inputmode="numeric"
                class="min-w-0 flex-1 rounded-xl border border-emerald-200 bg-white px-3 py-2 text-lg font-black text-emerald-950 outline-none focus:ring-2 focus:ring-emerald-500"
                value="20"
              />

              <span class="font-black text-emerald-900">
                %
              </span>
            </span>
          </label>

          <label class="rounded-2xl bg-amber-50 p-4 ring-1 ring-amber-100">
            <span class="block text-sm font-bold text-amber-700">
              Giving
            </span>

            <span class="mt-2 flex items-center gap-2">
              <input
                id="giving-percent"
                name="givingPercent"
                type="number"
                min="0"
                max="100"
                step="1"
                inputmode="numeric"
                class="min-w-0 flex-1 rounded-xl border border-amber-200 bg-white px-3 py-2 text-lg font-black text-amber-950 outline-none focus:ring-2 focus:ring-amber-500"
                value="10"
              />

              <span class="font-black text-amber-900">
                %
              </span>
            </span>
          </label>
        </div>

        <div
          id="split-status"
          class="mt-3 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700"
          aria-live="polite"
        >
          ✓ Total = 100%
        </div>
      </section>

      <section class="mt-6">
        <h3 class="text-lg font-black">
          Preview
        </h3>

        <div class="mt-3 overflow-hidden rounded-2xl border border-slate-200">
          <div
            id="allowance-preview"
            class="divide-y divide-slate-200"
          ></div>
        </div>
      </section>

      <section class="mt-5 flex items-center justify-between rounded-2xl bg-slate-100 px-5 py-4">
        <span class="font-black">
          Today's Total
        </span>

        <strong
          id="today-total"
          class="text-2xl font-black"
        >
          $0.00
        </strong>
      </section>

      <p
        id="allowance-error"
        class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"
      ></p>

      <button
        id="pay-allowance-submit"
        type="submit"
        class="mt-5 w-full rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-700 disabled:cursor-not-allowed disabled:bg-slate-300 disabled:text-slate-500"
      >
        Pay Allowance
      </button>
    </form>
  </dialog>

  <dialog
    id="balance-dialog"
    class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/55 backdrop:backdrop-blur-sm"
  >
    <form id="balance-form" class="p-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-blue-600">
            Parent adjustment
          </p>
          <h2 id="balance-dialog-title" class="mt-1 text-2xl font-black">
            Set balances
          </h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            Enter the amount that should be in each bucket.
          </p>
        </div>
        <button id="close-balance-dialog" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xl text-slate-600 transition hover:bg-slate-200" aria-label="Close">×</button>
      </div>

      <div class="mt-6 grid gap-3">
        <label class="rounded-2xl bg-blue-50 p-4 text-sm font-bold text-blue-700 ring-1 ring-blue-100">
          Spending
          <span class="mt-2 flex items-center rounded-xl border border-blue-200 bg-white px-3">
            <span class="text-slate-400">$</span>
            <input name="spending" type="number" min="0" step="0.01" inputmode="decimal" required class="min-w-0 w-full bg-transparent px-2 py-2 font-bold text-slate-900 outline-none" />
          </span>
        </label>
        <label class="rounded-2xl bg-emerald-50 p-4 text-sm font-bold text-emerald-700 ring-1 ring-emerald-100">
          Saving
          <span class="mt-2 flex items-center rounded-xl border border-emerald-200 bg-white px-3">
            <span class="text-slate-400">$</span>
            <input name="saving" type="number" min="0" step="0.01" inputmode="decimal" required class="min-w-0 w-full bg-transparent px-2 py-2 font-bold text-slate-900 outline-none" />
          </span>
        </label>
        <label class="rounded-2xl bg-amber-50 p-4 text-sm font-bold text-amber-700 ring-1 ring-amber-100">
          Giving
          <span class="mt-2 flex items-center rounded-xl border border-amber-200 bg-white px-3">
            <span class="text-slate-400">$</span>
            <input name="giving" type="number" min="0" step="0.01" inputmode="decimal" required class="min-w-0 w-full bg-transparent px-2 py-2 font-bold text-slate-900 outline-none" />
          </span>
        </label>
      </div>

      <input id="balance-kid-slug" name="slug" type="hidden" />
      <p id="balance-error" class="mt-4 hidden rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"></p>
      <button type="submit" class="mt-6 w-full rounded-xl bg-blue-600 px-5 py-3 font-bold text-white transition hover:bg-blue-700">
        Save Balances
      </button>
    </form>
  </dialog>

  <div
    id="toast"
    class="pointer-events-none fixed bottom-5 left-1/2 z-50 w-[calc(100%-2rem)] max-w-md -translate-x-1/2 translate-y-5 rounded-2xl bg-slate-950 px-5 py-4 text-center text-sm font-bold text-white opacity-0 shadow-2xl transition-all duration-200"
    role="status"
    aria-live="polite"
  ></div>

  <script
    type="application/json"
    id="demo-kids"
    set:html={demoJson}
  ></script>

  <script>
    import type {
      Kid,
    } from "../../types";
    import { escapeHtml } from "../../lib/html";
    import { profileAvatarHtml } from "../../lib/profileAvatar";

    import {
      createFallbackState,
      loadAllowanceSplit,
      loadState,
      payAllowance,
      resolvePurchaseRequest,
      saveAllowanceSplit,
      saveState,
      setBucketBalances,
      type AllowancePayment,
      type AllowanceSplit,
    } from "../../lib/store";

    const defaultSplit: AllowanceSplit = {
      spending: 70,
      saving: 20,
      giving: 10,
    };

    const demoElement =
      document.querySelector("#demo-kids");

    const demoKids = demoElement
      ? JSON.parse(
          demoElement.textContent || "{}",
        ) as Record<string, Kid>
      : {};

    let state = createFallbackState(demoKids);
    let savedSplit = defaultSplit;
    let loadErrorMessage = "";

    try {
      state = await loadState(demoKids);
    } catch (error) {
      loadErrorMessage = error instanceof Error
        ? error.message
        : "Unable to load saved family data.";
    }

    try {
      savedSplit = await loadAllowanceSplit(defaultSplit);
    } catch (error) {
      if (!loadErrorMessage) {
        loadErrorMessage = error instanceof Error
          ? error.message
          : "Unable to load the saved allowance split.";
      }
    }

    const money = new Intl.NumberFormat(
      "en-US",
      {
        style: "currency",
        currency: "USD",
      },
    );

    const allowanceButton =
      document.querySelector(
        "#allowance-button",
      );

    const allowanceDialog =
      document.querySelector(
        "#allowance-dialog",
      );

    const allowanceForm =
      document.querySelector(
        "#allowance-form",
      );

    const allowanceKids =
      document.querySelector(
        "#allowance-kids",
      );

    const allowancePreview =
      document.querySelector(
        "#allowance-preview",
      );

    const allowanceError =
      document.querySelector(
        "#allowance-error",
      );

    const splitStatus =
      document.querySelector(
        "#split-status",
      );

    const todayTotal =
      document.querySelector(
        "#today-total",
      );

    const paySubmit =
      document.querySelector(
        "#pay-allowance-submit",
      );

    const closeAllowanceDialog =
      document.querySelector(
        "#close-allowance-dialog",
      );

    const currentSplitSummary =
      document.querySelector(
        "#current-split-summary",
      );

    const spendingPercent =
      document.querySelector(
        "#spending-percent",
      );

    const savingPercent =
      document.querySelector(
        "#saving-percent",
      );

    const givingPercent =
      document.querySelector(
        "#giving-percent",
      );

    const toast =
      document.querySelector("#toast");

    const balanceDialog = document.querySelector("#balance-dialog");
    const balanceForm = document.querySelector("#balance-form");
    const balanceDialogTitle = document.querySelector("#balance-dialog-title");
    const balanceKidSlug = document.querySelector("#balance-kid-slug");
    const balanceError = document.querySelector("#balance-error");
    const closeBalanceDialog = document.querySelector("#close-balance-dialog");

    let toastTimeout:
      | number
      | undefined;

    function roundCurrency(
      amount: number,
    ): number {
      return Math.round(
        (amount + Number.EPSILON) * 100,
      ) / 100;
    }

    function showToast(
      message: string,
    ): void {
      if (!(toast instanceof HTMLElement)) {
        return;
      }

      window.clearTimeout(toastTimeout);

      toast.textContent = message;

      toast.classList.remove(
        "translate-y-5",
        "opacity-0",
      );

      toast.classList.add(
        "translate-y-0",
        "opacity-100",
      );

      toastTimeout = window.setTimeout(
        () => {
          toast.classList.remove(
            "translate-y-0",
            "opacity-100",
          );

          toast.classList.add(
            "translate-y-5",
            "opacity-0",
          );
        },
        2600,
      );
    }

    function getSplit(): AllowanceSplit {
      return {
        spending:
          spendingPercent instanceof HTMLInputElement
            ? Number(spendingPercent.value)
            : 0,

        saving:
          savingPercent instanceof HTMLInputElement
            ? Number(savingPercent.value)
            : 0,

        giving:
          givingPercent instanceof HTMLInputElement
            ? Number(givingPercent.value)
            : 0,
      };
    }

    function setSplit(
      split: AllowanceSplit,
    ): void {
      if (
        spendingPercent instanceof HTMLInputElement
      ) {
        spendingPercent.value =
          String(split.spending);
      }

      if (
        savingPercent instanceof HTMLInputElement
      ) {
        savingPercent.value =
          String(split.saving);
      }

      if (
        givingPercent instanceof HTMLInputElement
      ) {
        givingPercent.value =
          String(split.giving);
      }
    }

    function renderAllowanceKids(): void {
      if (
        !(allowanceKids instanceof HTMLElement)
      ) {
        return;
      }

      allowanceKids.innerHTML =
        Object.values(state.kids)
          .map(
            (kid) => `
              <label
                class="grid cursor-pointer grid-cols-[auto_auto_1fr] items-center gap-3 rounded-2xl border border-slate-200 p-4 transition has-[:checked]:border-emerald-300 has-[:checked]:bg-emerald-50 sm:grid-cols-[auto_auto_1fr_180px]"
              >
                <input
                  type="checkbox"
                  name="kid"
                  value="${escapeHtml(kid.slug)}"
                  checked
                  class="h-5 w-5 accent-emerald-600"
                />

                ${profileAvatarHtml(kid.slug as "judah" | "max", "small")}

                <span class="min-w-0">
                  <strong class="block">
                    ${escapeHtml(kid.name)}
                  </strong>

                  <span class="text-sm text-slate-500 sm:hidden">
                    Allowance
                  </span>
                </span>

                <span class="col-span-3 grid gap-1 sm:col-span-1">
                  <span class="hidden text-xs font-bold text-slate-500 sm:block">
                    Allowance
                  </span>

                  <span class="flex items-center rounded-xl border border-slate-200 bg-white px-3">
                    <span class="font-bold text-slate-400">
                      $
                    </span>

                    <input
                      type="number"
                      min="0"
                      step="0.01"
                      inputmode="decimal"
                      name="amount-${escapeHtml(kid.slug)}"
                      value="${kid.allowanceAmount.toFixed(2)}"
                      class="min-w-0 w-full bg-transparent px-2 py-2 font-bold outline-none"
                    />
                  </span>
                </span>
              </label>
            `,
          )
          .join("");

      allowanceKids
        .querySelectorAll("input")
        .forEach((input) => {
          input.addEventListener(
            "input",
            updateAllowanceEditor,
          );

          input.addEventListener(
            "change",
            updateAllowanceEditor,
          );
        });
    }

    function getSelectedPayments():
      AllowancePayment[] {
      if (
        !(allowanceForm instanceof HTMLFormElement)
      ) {
        return [];
      }

      const formData =
        new FormData(allowanceForm);

      return formData
        .getAll("kid")
        .map(String)
        .map((slug) => ({
          slug,
          amount: Number(
            formData.get(
              `amount-${slug}`,
            ),
          ),
        }));
    }

    function updateAllowanceEditor(): void {
      const split = getSplit();

      const splitTotal =
        split.spending +
        split.saving +
        split.giving;

      const percentagesValid =
        Number.isFinite(splitTotal) &&
        Math.abs(splitTotal - 100) < 0.001 &&
        split.spending >= 0 &&
        split.saving >= 0 &&
        split.giving >= 0;

      const payments =
        getSelectedPayments();

      const paymentsValid =
        payments.length > 0 &&
        payments.every(
          (payment) =>
            Number.isFinite(
              payment.amount,
            ) &&
            payment.amount > 0,
        );

      if (
        splitStatus instanceof HTMLElement
      ) {
        if (percentagesValid) {
          splitStatus.textContent =
            "✓ Total = 100%";

          splitStatus.className =
            "mt-3 rounded-xl bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-700";
        } else {
          splitStatus.textContent =
            `⚠ Total = ${Number.isFinite(splitTotal) ? splitTotal : 0}% — must equal 100%`;

          splitStatus.className =
            "mt-3 rounded-xl bg-red-50 px-4 py-3 text-sm font-bold text-red-700";
        }
      }

      if (
        paySubmit instanceof HTMLButtonElement
      ) {
        paySubmit.disabled =
          !percentagesValid ||
          !paymentsValid;
      }

      if (
        todayTotal instanceof HTMLElement
      ) {
        const total =
          payments.reduce(
            (sum, payment) =>
              sum + payment.amount,
            0,
          );

        todayTotal.textContent =
          money.format(total);
      }

      if (
        allowancePreview instanceof HTMLElement
      ) {
        allowancePreview.innerHTML =
          payments.length > 0
            ? payments
                .map((payment) => {
                  const kid =
                    state.kids[
                      payment.slug
                    ];

                  if (!kid) {
                    return "";
                  }

                  const spending =
                    roundCurrency(
                      payment.amount *
                        (
                          split.spending /
                          100
                        ),
                    );

                  const saving =
                    roundCurrency(
                      payment.amount *
                        (
                          split.saving /
                          100
                        ),
                    );

                  const giving =
                    roundCurrency(
                      payment.amount -
                        spending -
                        saving,
                    );

                  return `
                    <div class="p-4">
                      <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2">
                          ${profileAvatarHtml(kid.slug as "judah" | "max", "small")}

                          <strong>
                            ${escapeHtml(kid.name)}
                          </strong>
                        </div>

                        <span class="font-black">
                          ${money.format(payment.amount)}
                        </span>
                      </div>

                      <div class="mt-3 grid grid-cols-3 gap-2 text-center text-xs font-bold">
                        <div class="rounded-xl bg-blue-50 p-3 text-blue-800">
                          Spending<br />
                          ${money.format(spending)}
                        </div>

                        <div class="rounded-xl bg-emerald-50 p-3 text-emerald-800">
                          Saving<br />
                          ${money.format(saving)}
                        </div>

                        <div class="rounded-xl bg-amber-50 p-3 text-amber-800">
                          Giving<br />
                          ${money.format(giving)}
                        </div>
                      </div>
                    </div>
                  `;
                })
                .join("")
            : `
                <div class="p-6 text-center text-sm text-slate-500">
                  Select at least one child to see the preview.
                </div>
              `;
      }

      if (
        currentSplitSummary instanceof HTMLElement &&
        percentagesValid
      ) {
        currentSplitSummary.textContent =
          `${split.spending}% Spending · ${split.saving}% Saving · ${split.giving}% Giving`;
      }
    }

    function render(): void {
      const requestList =
        document.querySelector(
          "#request-list",
        );

      const requestCount =
        document.querySelector(
          "#request-count",
        );

      const kidList =
        document.querySelector(
          "#kid-list",
        );

      const familyBalance = document.querySelector(
        "#family-balance",
      );

      const kidCount = document.querySelector(
        "#kid-count",
      );

      const overviewRequestCount = document.querySelector(
        "#overview-request-count",
      );

      const familySavingsSummary = document.querySelector(
        "#family-savings-summary",
      );

      const savingsOverview = document.querySelector(
        "#savings-overview",
      );

      if (
        !(requestList instanceof HTMLElement) ||
        !(requestCount instanceof HTMLElement) ||
        !(kidList instanceof HTMLElement) ||
        !(familyBalance instanceof HTMLElement) ||
        !(kidCount instanceof HTMLElement) ||
        !(overviewRequestCount instanceof HTMLElement) ||
        !(familySavingsSummary instanceof HTMLElement) ||
        !(savingsOverview instanceof HTMLElement)
      ) {
        return;
      }

      const pending =
        state.purchaseRequests.filter(
          (request) =>
            request.status === "pending",
        );

      requestCount.textContent =
        `${pending.length} pending`;

      const kids = Object.values(state.kids);
      const totalBalance = kids.reduce(
        (familyTotal, kid) =>
          familyTotal +
          kid.buckets.spending +
          kid.buckets.saving +
          kid.buckets.giving,
        0,
      );

      familyBalance.textContent = money.format(totalBalance);
      kidCount.textContent = `${kids.length}`;
      overviewRequestCount.textContent =
        `${pending.length} ${pending.length === 1 ? "request" : "requests"}`;

      const familyAllocatedSavings = kids.reduce(
        (total, kid) => total + kid.goals.reduce(
          (kidTotal, goal) => kidTotal + goal.saved,
          0,
        ),
        0,
      );
      const familySavings = kids.reduce(
        (total, kid) => total + kid.buckets.saving,
        0,
      );
      const familyAvailableSavings = Math.max(
        0,
        familySavings - familyAllocatedSavings,
      );

      familySavingsSummary.textContent =
        `${money.format(familyAvailableSavings)} available · ${money.format(familyAllocatedSavings)} in goals`;

      savingsOverview.innerHTML = kids
        .map((kid) => {
          const allocated = kid.goals.reduce(
            (total, goal) => total + goal.saved,
            0,
          );
          const available = Math.max(
            0,
            kid.buckets.saving - allocated,
          );
          const goals = kid.goals.length > 0
            ? kid.goals.map((goal) => {
                const percent = goal.target > 0
                  ? Math.min(100, Math.max(0, (goal.saved / goal.target) * 100))
                  : 0;

                return `
                  <div class="border-t border-slate-100 pt-4 first:border-0 first:pt-0">
                    <div class="flex items-center justify-between gap-3 text-sm">
                      <span class="min-w-0 truncate font-bold text-slate-800">
                        ${escapeHtml(goal.emoji)} ${escapeHtml(goal.name)}
                      </span>
                      <span class="shrink-0 text-slate-500">
                        ${money.format(goal.saved)} / ${money.format(goal.target)}
                      </span>
                    </div>
                    <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200" role="progressbar" aria-label="${escapeHtml(goal.name)} savings progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.round(percent)}">
                      <div class="h-full rounded-full bg-emerald-500" style="width: ${percent}%"></div>
                    </div>
                  </div>
                `;
              }).join("")
            : `
                <div class="rounded-2xl bg-emerald-50 p-4 text-center ring-1 ring-emerald-100">
                  <div class="text-2xl" aria-hidden="true">🌱</div>
                  <p class="mt-2 text-sm font-bold text-emerald-900">No goals yet</p>
                  <p class="mt-1 text-xs leading-5 text-emerald-700">Goals created from this kid's account will appear here.</p>
                </div>
              `;

          return `
            <article class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  ${profileAvatarHtml(kid.slug as "judah" | "max")}
                  <div>
                    <h3 class="text-lg font-black">${escapeHtml(kid.name)}</h3>
                    <p class="text-sm text-slate-500">${money.format(kid.buckets.saving)} total Saving</p>
                  </div>
                </div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm font-bold text-emerald-700">
                  ${money.format(available)} available
                </span>
              </div>
              <div class="mt-5 grid gap-4">
                ${goals}
              </div>
            </article>
          `;
        })
        .join("");

      requestList.innerHTML =
        pending.length > 0
          ? pending
              .map(
                (request) => `
                  <article class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
                    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                      <div>
                        <p class="text-sm font-bold text-slate-500">
                          ${escapeHtml(request.kidName)} wants to record
                        </p>

                        <h3 class="mt-1 text-lg font-black">
                          ${escapeHtml(request.description)}
                        </h3>

                        <p class="mt-1 text-sm capitalize text-slate-500">
                          ${money.format(request.amount)}
                          from ${escapeHtml(request.bucket)}
                        </p>
                      </div>

                      <div class="flex gap-2">
                        <button
                          data-decline="${escapeHtml(request.id)}"
                          class="rounded-xl bg-red-50 px-4 py-3 font-bold text-red-700"
                        >
                          Decline
                        </button>

                        <button
                          data-approve="${escapeHtml(request.id)}"
                          class="rounded-xl bg-emerald-600 px-4 py-3 font-bold text-white"
                        >
                          Approve
                        </button>
                      </div>
                    </div>
                  </article>
                `,
              )
              .join("")
          : `
              <div class="rounded-2xl bg-white p-8 text-center ring-1 ring-slate-200">
                <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-emerald-50 text-3xl" aria-hidden="true">👍</div>
                <h3 class="mt-4 font-black text-slate-900">You're all caught up</h3>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
                  New purchase requests from Judah or Max will appear here.
                </p>
              </div>
            `;

      kidList.innerHTML =
        kids
          .map((kid) => {
            const total =
              kid.buckets.spending +
              kid.buckets.saving +
              kid.buckets.giving;

            return `
              <article class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <div class="flex items-center gap-3">
                  ${profileAvatarHtml(kid.slug as "judah" | "max")}

                  <div>
                    <h3 class="text-xl font-black">
                      ${escapeHtml(kid.name)}
                    </h3>

                    <p class="text-sm text-slate-500">
                      ${money.format(total)} total
                    </p>
                  </div>
                </div>

                <div class="mt-5 grid grid-cols-3 gap-2 text-center text-xs font-bold">
                  <div class="rounded-xl bg-blue-50 p-3 text-blue-800">
                    Spend<br />
                    ${money.format(kid.buckets.spending)}
                  </div>

                  <div class="rounded-xl bg-emerald-50 p-3 text-emerald-800">
                    Save<br />
                    ${money.format(kid.buckets.saving)}
                  </div>

                  <div class="rounded-xl bg-amber-50 p-3 text-amber-800">
                    Give<br />
                    ${money.format(kid.buckets.giving)}
                  </div>
                </div>

                <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-sm">
                  <span class="text-slate-500">
                    ${money.format(kid.allowanceAmount)} allowance
                  </span>

                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      data-set-balances="${escapeHtml(kid.slug)}"
                      class="rounded-lg bg-slate-100 px-3 py-2 font-bold text-slate-700 transition hover:bg-slate-200"
                    >
                      Set balances
                    </button>

                    <a
                      href="${import.meta.env.BASE_URL}kids/${kid.slug}/"
                      class="rounded-lg px-3 py-2 font-bold text-blue-600 transition hover:bg-blue-50"
                    >
                      Open →
                    </a>
                  </div>
                </div>
              </article>
            `;
          })
          .join("");

      document
        .querySelectorAll<HTMLElement>("[data-set-balances]")
        .forEach((button) => {
          button.onclick = () => {
            const slug = button.dataset.setBalances ?? "";
            const kid = state.kids[slug];

            if (!kid || !(balanceDialog instanceof HTMLDialogElement)) return;

            if (balanceDialogTitle instanceof HTMLElement) {
              balanceDialogTitle.textContent = `Set ${kid.name}'s balances`;
            }
            if (balanceKidSlug instanceof HTMLInputElement) {
              balanceKidSlug.value = kid.slug;
            }
            if (balanceForm instanceof HTMLFormElement) {
              const fields = balanceForm.elements;
              const spending = fields.namedItem("spending");
              const saving = fields.namedItem("saving");
              const giving = fields.namedItem("giving");

              if (spending instanceof HTMLInputElement) spending.value = kid.buckets.spending.toFixed(2);
              if (saving instanceof HTMLInputElement) saving.value = kid.buckets.saving.toFixed(2);
              if (giving instanceof HTMLInputElement) giving.value = kid.buckets.giving.toFixed(2);
            }
            if (balanceError instanceof HTMLElement) {
              balanceError.classList.add("hidden");
              balanceError.textContent = "";
            }

            balanceDialog.showModal();
          };
        });

      document
        .querySelectorAll<HTMLElement>(
          "[data-decline]",
        )
        .forEach((button) => {
          button.onclick = async () => {
            try {
              resolvePurchaseRequest(
                state,
                button.dataset.decline ?? "",
                "declined",
              );
              await saveState(state);
              render();
              showToast("Purchase declined.");
            } catch (error) {
              window.alert(
                error instanceof Error
                  ? error.message
                  : "Unable to decline the purchase.",
              );
            }
          };
        });

      document
        .querySelectorAll<HTMLElement>(
          "[data-approve]",
        )
        .forEach((button) => {
          button.onclick = async () => {
            try {
              resolvePurchaseRequest(
                state,
                button.dataset.approve ?? "",
                "approved",
              );
              await saveState(state);
              render();
              showToast("Purchase approved!");
            } catch (error) {
              window.alert(
                error instanceof Error
                  ? error.message
                  : "Unable to approve the purchase.",
              );
            }
          };
        });
    }

    closeBalanceDialog?.addEventListener("click", () => {
      if (balanceDialog instanceof HTMLDialogElement) balanceDialog.close();
    });

    balanceDialog?.addEventListener("click", (event) => {
      if (
        balanceDialog instanceof HTMLDialogElement &&
        event.target === balanceDialog
      ) {
        balanceDialog.close();
      }
    });

    balanceForm?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!(balanceForm instanceof HTMLFormElement)) return;

      const data = new FormData(balanceForm);
      const slug = String(data.get("slug") ?? "");

      try {
        setBucketBalances(state, slug, {
          spending: Number(data.get("spending")),
          saving: Number(data.get("saving")),
          giving: Number(data.get("giving")),
        });
        await saveState(state);
        render();

        if (balanceDialog instanceof HTMLDialogElement) {
          balanceDialog.close();
        }

        showToast("Balances updated! ✏️");
      } catch (error) {
        if (balanceError instanceof HTMLElement) {
          balanceError.textContent = error instanceof Error
            ? error.message
            : "Unable to update balances.";
          balanceError.classList.remove("hidden");
        }
      }
    });

    allowanceButton?.addEventListener(
      "click",
      () => {
        renderAllowanceKids();
        setSplit(savedSplit);

        if (
          allowanceError instanceof HTMLElement
        ) {
          allowanceError.classList.add(
            "hidden",
          );
        }

        updateAllowanceEditor();

        if (
          allowanceDialog instanceof HTMLDialogElement
        ) {
          allowanceDialog.showModal();
        }
      },
    );

    closeAllowanceDialog?.addEventListener(
      "click",
      () => {
        if (
          allowanceDialog instanceof HTMLDialogElement
        ) {
          allowanceDialog.close();
        }
      },
    );

    [
      spendingPercent,
      savingPercent,
      givingPercent,
    ].forEach((input) => {
      input?.addEventListener(
        "input",
        updateAllowanceEditor,
      );
    });

    allowanceForm?.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        const payments =
          getSelectedPayments();

        const split =
          getSplit();

        try {
          payAllowance(
            state,
            payments,
            split,
          );

          await saveAllowanceSplit(split);
          await saveState(state);
          savedSplit = split;

          render();

          if (
            allowanceDialog instanceof HTMLDialogElement
          ) {
            allowanceDialog.close();
          }

          showToast(
            "Allowance paid! 🎉",
          );
        } catch (error) {
          if (
            allowanceError instanceof HTMLElement
          ) {
            allowanceError.textContent =
              error instanceof Error
                ? error.message
                : "Unable to pay allowance.";

            allowanceError.classList.remove(
              "hidden",
            );
          }
        }
      },
    );

    setSplit(savedSplit);
    updateAllowanceEditor();
    render();
    if (loadErrorMessage) showToast(loadErrorMessage);
  </script>
</Layout>
