---
import GoalCard from "./GoalCard.astro";
import type { Goal } from "../../types";

interface Props {
  goals: Goal[];
}

const { goals } = Astro.props;
---

<section class="mt-10">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
        Saving
      </p>

      <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">
        My goals
      </h2>
    </div>

    <button
      type="button"
      data-new-goal
      class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-4 text-sm font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500"
    >
      + New goal
    </button>
  </div>

  {
    goals.length > 0 ? (
      <div class="grid gap-4">
        {goals.map((goal) => (
          <GoalCard
            id={goal.id}
            name={goal.name}
            emoji={goal.emoji}
            saved={goal.saved}
            target={goal.target}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-3xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
        <div class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-emerald-50 text-3xl" aria-hidden="true">🎯</div>
        <h3 class="mt-4 text-lg font-black">Pick something worth saving for</h3>
        <p class="mx-auto mt-2 max-w-sm text-sm leading-6 text-slate-500">
          Your first goal can be anything you are excited to work toward.
        </p>
        <button
          type="button"
          data-new-goal
          class="mt-5 inline-flex min-h-11 items-center justify-center rounded-xl bg-emerald-600 px-5 text-sm font-bold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
        >
          Create my first goal
        </button>
      </div>
    )
  }
</section>
