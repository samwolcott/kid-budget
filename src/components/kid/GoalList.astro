---
import GoalCard from "./GoalCard.astro";
import type { Goal } from "../../types";

interface Props {
  goals: Goal[];
}

const { goals } = Astro.props;
---

<section class="mt-10">
  <div class="mb-4 flex items-end justify-between gap-4">
    <div>
      <p class="text-xs font-extrabold uppercase tracking-[0.18em] text-emerald-600">
        Saving
      </p>

      <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-950">
        My goals
      </h2>
    </div>

    <button
      type="button"
      class="inline-flex min-h-11 items-center justify-center rounded-xl bg-white px-4 text-sm font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500"
    >
      + New goal
    </button>
  </div>

  {
    goals.length > 0 ? (
      <div class="grid gap-4">
        {goals.map((goal) => (
          <GoalCard
            id={goal.id}
            name={goal.name}
            emoji={goal.emoji}
            saved={goal.saved}
            target={goal.target}
          />
        ))}
      </div>
    ) : (
      <div class="rounded-3xl bg-white p-8 text-center shadow-sm ring-1 ring-slate-200">
        <div class="text-4xl" aria-hidden="true">🎯</div>
        <h3 class="mt-3 text-lg font-black">No goals yet</h3>
        <p class="mt-2 text-sm leading-6 text-slate-500">
          Create a goal for something you would like to save for.
        </p>
      </div>
    )
  }
</section>
