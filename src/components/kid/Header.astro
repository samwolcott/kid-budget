---
import ProfileControls from "../ProfileControls.astro";

interface Props {
  name: string;
  emoji: string;
  slug: "judah" | "max";
}

const { name, emoji, slug } = Astro.props;
---

<header class="mb-6 flex items-center justify-between gap-4">
  <div class="flex items-center gap-4">
    <div
      class="grid h-14 w-14 place-items-center rounded-2xl bg-white text-3xl shadow-sm ring-1 ring-slate-200"
      aria-hidden="true"
    >
      {emoji}
    </div>

    <div>
      <p class="text-sm font-bold uppercase tracking-[0.18em] text-blue-600">
        My account
      </p>

      <h1 class="mt-1 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
        {name}
      </h1>
    </div>
  </div>

  <ProfileControls profile={slug} />
</header>
